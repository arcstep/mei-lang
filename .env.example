# OpenAI 兼容模型（内置 agent）
OPENAI_IMITATORS=QWEN
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your_api_key
QWEN_COMPLETION_MODEL=qwen-max

# GIS 底图：浏览器默认走同源 /gis
# 默认：Host 在 stock/gis/tiles 有 mbtiles 时自动托管 Martin（随机端口）
# 仅在使用外部 Martin（Docker / start_martin.sh）时设置上游，Host 将跳过自动托管：
# MEI_GIS_PROXY_UPSTREAM=http://127.0.0.1:18080
# 可选：覆盖 martin 二进制路径
# MEI_MARTIN_BIN=/usr/local/bin/martin
MEI_TILES_JSON_PATH=/demo-tiles
