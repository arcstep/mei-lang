# OpenAI 兼容模型（内置 agent）
OPENAI_IMITATORS=QWEN
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your_api_key
QWEN_COMPLETION_MODEL=qwen-max

# GIS 底图：浏览器默认走同源 /gis；宿主再把 /gis 代理到真实 Martin 上游
# 启动瓦片：在 mei-projects 根目录执行 ./scripts/start_martin_docker.sh
MEI_GIS_PROXY_UPSTREAM=http://127.0.0.1:8080
MEI_TILES_JSON_PATH=/demo-tiles
