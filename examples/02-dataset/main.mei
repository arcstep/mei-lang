app(
    id = "02-dataset",
    title = "02 Dataset",
    default_scene = "home",
)

app.add_scene(
    id = "home",
    profile = "page",
    summary = "app 直接拥有 scene，用同一份 world dataset 驱动多个默认观察面消费。",
)

scene.set_world(
    resources = [
        resource(
            id = "dataset_doc",
            kind = "document",
            title = "例子说明",
            content = "## Dataset 例子\n\n这个例子现在主要验证：\n1. `app -> scene -> world / frame` 的显式归属比旧入口写法更清楚；\n2. 宿主能从 examples 路径读取文件；\n3. kernel 能把 CSV 装配成 world 资源；\n4. 同一份 dataset 可以被默认 frame 中的多个观察面同时消费；\n5. table / summary / chart 目前仍是组件消费链，不代表 brick contract 已经正式实现；\n6. 后续如果进入 `world -> brick -> projection -> frame`，这里应作为过渡基线继续演化。",
        ),
        resource(
            id = "sales_data",
            kind = "dataset",
            title = "销售样本 CSV",
            source = ds.csv(path = "data/sales.csv"),
        ),
    ],
)

scene.set_frame(
    layout = grid(
        columns = ["1fr", "2fr"],
        rows = ["auto", "minmax(220px, 1fr)"],
        areas = [
            ["doc", "table"],
            ["summary", "chart"],
        ],
        gap = "16px",
        padding = "20px",
    ),
)

frame.add_panel(
    id = "doc_panel",
    area = "doc",
    blocks = [
        doc.markdown(
            area = "auto",
            resource = world_ref("dataset_doc"),
        ),
    ],
)

frame.add_panel(
    id = "table_panel",
    area = "table",
    blocks = [
        component(
            "dataset.table",
            area = "auto",
            props = {
                "dataset": world_ref("sales_data"),
            },
        ),
    ],
)

frame.add_panel(
    id = "summary_panel",
    area = "summary",
    blocks = [
        component(
            "dataset.summary-cards",
            area = "auto",
            props = {
                "dataset": world_ref("sales_data"),
                "metrics": [
                    {"label": "指标条目", "op": "count"},
                    {"label": "数值总和", "op": "sum", "column": "value"},
                    {"label": "数值均值", "op": "avg", "column": "value"},
                ],
            },
        ),
    ],
)

frame.add_panel(
    id = "chart_panel",
    area = "chart",
    blocks = [
        component(
            "chart.bar-mini",
            area = "auto",
            props = {
                "title": "销售指标对比（bar-mini）",
                "dataset": world_ref("sales_data"),
                "labelField": "label",
                "valueField": "value",
            },
        ),
    ],
)
