app(
    id = "02-dataset",
    title = "02 Dataset",
    entries = [
        entry(scene = "main.mei", id = "home", title = "02 Dataset"),
    ],
)

scene(
    id = "home",
    profile = "page",
    summary = "用 scene-first 装配文件读取与 dataset 预览。",
)

world(
    resources = [
        resource(
            id = "dataset_doc",
            kind = "document",
            title = "例子说明",
            content = "## Dataset 例子\n\n这个例子验证：\n1. 宿主能从 examples 路径读取文件；\n2. kernel 能把 CSV 装配成 world 资源；\n3. 多个外部组件可以通过 `world_ref(...)` 消费同一份 dataset；\n4. 当前 chart 先作为外部组件扩展，而不是内建语法。",
        ),
        resource(
            id = "sales_data",
            kind = "dataset",
            title = "销售样本 CSV",
            source = ds.csv(path = "data/sales.csv"),
        ),
    ],
)

frame(
    title = "02 Dataset",
    layout = grid(
        columns = ["1fr", "2fr"],
        rows = ["auto", "minmax(220px, 1fr)"],
        areas = [
            ["doc", "table"],
            ["summary", "chart"],
        ],
        gap = "16px",
        padding = "20px",
    ),
)

panel(
    id = "doc_panel",
    title = "说明",
    area = "doc",
    blocks = [
        doc.markdown(
            area = "auto",
            resource = world_ref("dataset_doc"),
        ),
    ],
)

panel(
    id = "table_panel",
    title = "CSV 预览",
    area = "table",
    blocks = [
        component(
            "dataset.table",
            area = "auto",
            props = {
                "dataset": world_ref("sales_data"),
            },
        ),
    ],
)

panel(
    id = "summary_panel",
    title = "摘要卡片（外部组件）",
    area = "summary",
    blocks = [
        component(
            "dataset.summary-cards",
            area = "auto",
            props = {
                "dataset": world_ref("sales_data"),
                "metrics": [
                    {"label": "指标条目", "op": "count"},
                    {"label": "数值总和", "op": "sum", "column": "value"},
                    {"label": "数值均值", "op": "avg", "column": "value"},
                ],
            },
        ),
    ],
)

panel(
    id = "chart_panel",
    title = "最小图表位（外部组件）",
    area = "chart",
    blocks = [
        component(
            "chart.bar-mini",
            area = "auto",
            props = {
                "title": "销售指标对比（bar-mini）",
                "dataset": world_ref("sales_data"),
                "labelField": "label",
                "valueField": "value",
            },
        ),
    ],
)
