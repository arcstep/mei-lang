app(
    id = "02-dataset",
    title = "02 Dataset",
    entries = [
        entry(frame = "main.mei", id = "home", title = "02 Dataset"),
    ],
)

frame(
    title = "02 Dataset",
    layout = flex(direction = "column", gap = "16px", padding = "20px"),
)

ds.dataset(
    id = "sales",
    title = "销售样本 CSV",
    source = ds.csv(path = "data/sales.csv"),
)

doc.markdown(
    area = "auto",
    title = "说明",
    content = "## Dataset 例子\n\n这个例子只验证两件事：\n1. 宿主能从 examples 路径读取源文件；\n2. kernel 能把 CSV 装配成最小 dataset 预览。",
)

component(
    "dataset.table",
    area = "auto",
    title = "CSV 预览",
    data = ds.dataset_ref("sales"),
    props = {
        "caption": "示例销售数据",
    },
)
