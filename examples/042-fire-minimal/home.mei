app.add_scene(
    id = "minimal_fire_cells",
    profile = "simulation",
    summary = "最小 fire cell 语义例子：先验证 topology.grid、cell hazard state、tool/actor/asset 的共同存在。",
    goal = "验证 cell 作为危险状态载体，而不是只把火理解成一个实体。",
    state = {
        "phase": "ready",
        "countdown": 20,
    },
)

scene.set_world(
    topology = grid(
        rows = 4,
        cols = 4,
        cells = [
            cell("r1c1", row = 1, col = 1, surface_kind = "corner", flammable = True, walkable = True, occupiable = True, hazard_state = "smoke", tags = ["ignition_candidate", "room_a"]),
            cell("r1c2", row = 1, col = 2, surface_kind = "floor", flammable = True, walkable = True, occupiable = True, tags = ["room_a"]),
            cell("r2c2", row = 2, col = 2, surface_kind = "storage", flammable = True, walkable = True, occupiable = True, tags = ["asset_zone", "room_a"]),
            cell("r4c4", row = 4, col = 4, surface_kind = "equipment", flammable = False, walkable = True, occupiable = True, tags = ["tool_spawn"]),
        ],
    ),
    entities = [
        entity(
            id = "player",
            kind = "actor",
            label = "演练者",
            spawns = ["r4c1"],
            flags = {"alive": True},
        ),
        entity(
            id = "extinguisher_1",
            kind = "tool",
            label = "灭火器",
            spawns = ["r4c4"],
            flags = {"portable": True},
        ),
        entity(
            id = "asset_cashbox",
            kind = "asset",
            label = "贵重箱",
            spawns = ["r2c2"],
            flags = {"valuable": True},
        ),
    ],
)

scene.set_flow(
    start = start(mode = "manual", action_label = "开始最小 fire"),
    interactions = [
        click(
            target = "extinguisher_1",
            effect = grant("extinguisher_1"),
        ),
        click(
            target = "cell:r1c1",
            require = has("extinguisher_1"),
            effect = effects([
                set_status("cell:r1c1", "out"),
                finish("success", "minimal_fire_success"),
            ]),
        ),
    ],
    subject_timers = [
        subject_timer(
            id = "cell-r1c1-smoke-to-burning",
            subject_ref = "cell:r1c1",
            timer_type = "state_transition",
            delay_seconds = 5,
            on_timeout = set_status("cell:r1c1", "burning"),
        ),
        subject_timer(
            id = "cell-r1c1-burning-to-engulfed",
            subject_ref = "cell:r1c1",
            timer_type = "state_transition",
            delay_seconds = 10,
            on_timeout = effects([
                set_status("cell:r1c1", "engulfed"),
                finish("fail", "minimal_fire_cell_engulfed"),
            ]),
        ),
    ],
    timer = rule_timer(
        seconds = 20,
        on_timeout = finish("fail", "minimal_fire_timeout"),
    ),
    outcome = rule_outcome(
        success = "minimal_fire_success",
        fail = "minimal_fire_timeout",
    ),
)

scene.set_frame(
    layout = grid(
        columns = ["2fr", "1fr"],
        areas = [
            ["board", "notes"],
        ],
        gap = "12px",
        padding = "20px",
    ),
)

frame.add_panel(
    id = "board",
    area = "board",
    layout = flex(direction = "column", gap = "10px"),
    blocks = [
        component(
            "sim.step-bridge",
            area = "auto",
            props = {
                "scene": scene_ref("self"),
            },
        ),
        component(
            "sim.outcome-hud",
            area = "auto",
            props = {
                "scene": scene_ref("self"),
            },
        ),
        component(
            "sim.affordance-bar",
            area = "auto",
            props = {
                "scene": scene_ref("self"),
            },
        ),
        component(
            "sim.board-grid",
            area = "auto",
            props = {
                "scene": scene_ref("self"),
            },
        ),
    ],
)

frame.add_panel(
    id = "notes",
    area = "notes",
    blocks = [
        doc.markdown(
            area = "auto",
            content = "## Minimal Fire\n\n当前这个例子已经形成最小可玩闭环：\n1. 点击开始后，`cell:r1c1` 会从 smoke 进入 burning；\n2. 玩家先拿灭火器，再点击目标格子可触发 success；\n3. 若未及时处置，格子会进入 engulfed 或全局倒计时超时导致 fail。\n\n同时它也不再依赖单一 `sim.scene` 超级组件，而是用 `sim.step-bridge / sim.affordance-bar / sim.board-grid / sim.outcome-hud` 进行组合。",
        ),
    ],
)
