app(
    id = "03-cockpit",
    title = "03 Cockpit",
    default_scene = "home",
)

app.add_scene(
    id = "home",
    profile = "cockpit",
    summary = "app 直接拥有 scene 的简单看板例子。",
)

scene.set_world(
    resources = [
        resource(
            id = "metrics",
            kind = "dataset",
            title = "驾驶舱指标",
            source = ds.csv(path = "data/metrics.csv"),
        ),
        resource(
            id = "cockpit_doc",
            kind = "document",
            title = "看板说明",
            content = "## Cockpit 例子\n\n这个例子验证：\n1. scene-first 下的看板组织；\n2. `world.resources` 进入组件消费；\n3. `frame + panel(blocks)` 的局部 UI 写法。",
        ),
    ],
)

scene.set_frame(
    layout = grid(
        columns = ["2fr", "1fr"],
        areas = [
            ["cards", "doc"],
        ],
        gap = "16px",
        padding = "20px",
    ),
)

frame.add_panel(
    id = "cards_panel",
    area = "cards",
    blocks = [
        component(
            "cockpit.metric-cards",
            area = "auto",
            props = {
                "dataset": world_ref("metrics"),
            },
        ),
    ],
)

frame.add_panel(
    id = "doc_panel",
    area = "doc",
    blocks = [
        doc.markdown(
            area = "auto",
            resource = world_ref("cockpit_doc"),
        ),
    ],
)
