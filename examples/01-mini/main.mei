app(
    id = "01-mini",
    title = "01 Mini",
    entries = [
        entry(scene = "main.mei", id = "home", title = "01 Mini"),
    ],
)

scene(
    id = "home",
    profile = "page",
    summary = "最小单文件 scene-first 例子。",
)

world(
    resources = [
        resource(
            id = "welcome_doc",
            kind = "document",
            title = "欢迎文档",
            content = "# Hello MeiLang\n\n这是新骨架中的最小单文件例子，用来验证 scene-first 工程链路、宿主壳层和 workspace web-components 已经接通。",
        ),
    ],
)

frame(
    title = "01 Mini",
    layout = flex(direction = "column", gap = "16px", padding = "20px"),
)

panel(
    id = "welcome",
    title = "欢迎",
    area = "auto",
    blocks = [
        doc.markdown(
            area = "auto",
            resource = world_ref("welcome_doc"),
        ),
    ],
)
