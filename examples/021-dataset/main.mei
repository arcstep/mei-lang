app(
    id = "021-dataset",
    title = "021 Dataset",
    default_scene = "home",
)

app.add_scene(
    id = "home",
    profile = "page",
    summary = "app 直接拥有 scene，用同一份 world dataset 驱动多个默认观察面消费。",
)

scene.set_world(
    resources = [
        resource(
            id = "dataset_doc",
            kind = "document",
            title = "例子说明",
            content = "## Dataset 例子\n\n这个例子现在主要验证：\n1. dataset 资源可以先进入 world；\n2. 再通过 `ds.dataset_view(...)` 派生稳定数据视图；\n3. `data_ref(...)` 与 `metric_ref(...)` 可以作为统一绑定来源；\n4. table / summary / chart 消费同一份 data contract。",
        ),
        resource(
            id = "sales_data",
            kind = "dataset",
            title = "销售样本 CSV",
            source = ds.csv(path = "data/sales.csv"),
        ),
    ],
)

sales_rows = ds.data_ref("sales_data")
clean_rows = ds.pipe(
    sales_rows,
    ds.step_where(ds.not_empty("label")),
    ds.step_sort("value", order = "desc"),
    ds.step_limit(200),
)
ranking_rows = ds.group_by(clean_rows, fields = ["label"], value = "value", agg = "sum")

ds.dataset_view(
    id = "sales_analytics",
    title = "销售分析视图",
    rowset = sales_rows,
    schema = [
        ds.column("label", "string"),
        ds.column("value", "number", unit = "元"),
        ds.column("unit", "string"),
    ],
    metrics = [
        ds.scalar_map(
            id = "sales_overview",
            label = "销售概览",
            schema = [
                ds.column("total_rows", "number", unit = "条"),
                ds.column("total_value", "number", unit = "元"),
                ds.column("avg_value", "number", unit = "元"),
            ],
            values = {
                "total_rows": ds.count(sales_rows),
                "total_value": ds.sum(ds.number(sales_rows, "value")),
                "avg_value": ds.avg(ds.number(sales_rows, "value")),
            },
        ),
        ds.dataframe(
            id = "sales_ranking",
            label = "销售对比",
            schema = [
                ds.column("label", "string"),
                ds.column("value", "number", unit = "元"),
            ],
            value = ranking_rows,
        ),
    ],
)

ds.metric_pack(
    id = "sales_pack",
    metrics = [
        ds.computed_metric(
            key = "pack_total_value",
            label = "pack 总额",
            dataset = "sales_analytics",
            op = ds.sum_numeric_field(field = "value"),
            fallback = 0,
        ),
        ds.computed_metric(
            key = "pack_focus_rate",
            label = "重点指标占比",
            dataset = "sales_analytics",
            op = ds.percent_of_eq("label", "A"),
            fallback = 0,
        ),
    ],
)

scene.set_frame(
    layout = grid(
        columns = ["1fr", "2fr"],
        rows = ["auto", "minmax(220px, 1fr)"],
        areas = [
            ["doc", "table"],
            ["summary", "chart"],
        ],
        gap = "16px",
        padding = "20px",
    ),
)

frame.add_panel(
    id = "doc_panel",
    area = "doc",
    blocks = [
        doc.markdown(
            area = "auto",
            resource = world_ref("dataset_doc"),
        ),
    ],
)

frame.add_panel(
    id = "table_panel",
    area = "table",
    blocks = [
        component(
            "dataset.table",
            area = "auto",
            props = {
                "data": ds.data_ref("sales_analytics"),
            },
        ),
    ],
)

frame.add_panel(
    id = "summary_panel",
    area = "summary",
    blocks = [
        component(
            "dataset.summary-cards",
            area = "auto",
            props = {
                "value": ds.metric_ref("sales_overview", from_dataset = "sales_analytics"),
            },
        ),
    ],
)

frame.add_panel(
    id = "chart_panel",
    area = "chart",
    blocks = [
        component(
            "chart.bar-mini",
            area = "auto",
            props = {
                "title": "销售指标对比（metric + mapping）",
                "data": ds.metric_ref("sales_ranking", from_dataset = "sales_analytics"),
                "mapping": {
                    "x": [{"field": "label", "name": "指标"}],
                    "y": [{"field": "value", "name": "数值"}],
                },
            },
        ),
    ],
)
