app.add_scene(
    id = "room_fire_click",
    profile = "simulation",
    summary = "房间角落随机起火。先点灭火器，再点火点。用于验证 scene-first 与最小运行态骨架。",
    goal = "在倒计时结束前灭火",
    state = {
        "phase": "ready",
        "countdown": 12,
    },
)

scene.set_world(
    topology = grid(
        rows = 4,
        cols = 4,
    ),
    entities = [
        entity(
            id = "room_fire",
            kind = "hazard",
            label = "火点",
            spawns = ["r1c1", "r1c4", "r4c1", "r4c4"],
            status = "small",
        ),
        entity(
            id = "wall_extinguisher",
            kind = "tool",
            label = "灭火器",
            spawns = ["r2c2", "r2c3", "r3c2", "r3c3"],
        ),
        entity(
            id = "player",
            kind = "actor",
            label = "演练者",
            flags = {"alive": True},
        ),
    ],
)

scene.set_flow(
    start = start(mode = "manual", action_label = "开始演练"),
    interactions = [
        click(
            target = "wall_extinguisher",
            effect = grant("wall_extinguisher"),
        ),
        click(
            target = "room_fire",
            require = has("wall_extinguisher"),
            effect = effects([
                set_status("room_fire", "out"),
                finish("success", "fire_out_before_timeout"),
            ]),
        ),
    ],
    timer = rule_timer(
        seconds = 12,
        on_timeout = effects([
            set_status("room_fire", "big"),
            set_flag("player.alive", False),
            finish("fail", "timeout_or_player_dead"),
        ]),
    ),
    outcome = rule_outcome(
        success = "fire_out_before_timeout",
        fail = "timeout_or_player_dead",
    ),
)

scene.set_frame(
    layout = grid(
        columns = ["2fr", "1fr"],
        areas = [
            ["board", "status"],
        ],
        gap = "12px",
        padding = "20px",
    ),
)

frame.add_panel(
    id = "board",
    area = "board",
    blocks = [
        component(
            "sim.scene",
            area = "auto",
            props = {
                "scene": scene_ref("self"),
            },
        ),
    ],
)

frame.add_panel(
    id = "status",
    area = "status",
    blocks = [
        doc.markdown(
            area = "auto",
            content = "## Fire 例子\n\n这个例子现在用于验证最小运行链路：\n1. `scene / world / flow / frame` 先编译为统一 contract；\n2. `sim.scene` 通过 `/api/sim/step/:app_id` 驱动 `start / click / tick / restart`；\n3. UI 与 runtime 共用同一份 scene contract，而不是各自解释一遍逻辑。",
        ),
    ],
)
