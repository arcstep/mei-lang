app(
    id = "031-cockpit",
    title = "031 Cockpit",
    default_scene = "home",
)

app.add_scene(
    id = "home",
    profile = "cockpit",
    summary = "app 直接拥有 scene 的简单看板例子。",
)

scene.set_world(
    resources = [
        resource(
            id = "metrics",
            kind = "dataset",
            title = "驾驶舱指标",
            source = ds.csv(path = "data/metrics.csv"),
        ),
        resource(
            id = "cockpit_doc",
            kind = "document",
            title = "看板说明",
            content = "## Cockpit 例子\n\n这个例子只验证组合消费：\n1. cockpit 壳层组件如何消费 data contract；\n2. 同一份 dataset_view 可以供多个组件复用；\n3. 这里不是 data/chart 主契约定义样本。",
        ),
    ],
)

metric_rows = ds.data_ref("metrics")

ds.dataset_view(
    id = "cockpit_metrics_view",
    title = "驾驶舱指标视图",
    rowset = metric_rows,
    schema = [
        ds.column("label", "string"),
        ds.column("value", "number"),
        ds.column("unit", "string"),
    ],
)

scene.set_frame(
    layout = grid(
        columns = ["2fr", "1fr"],
        areas = [
            ["cards", "doc"],
        ],
        gap = "16px",
        padding = "20px",
    ),
)

frame.add_panel(
    id = "cards_panel",
    area = "cards",
    blocks = [
        component(
            "cockpit.metric-cards",
            area = "auto",
            props = {
                "dataset": ds.data_ref("cockpit_metrics_view"),
            },
        ),
    ],
)

frame.add_panel(
    id = "doc_panel",
    area = "doc",
    blocks = [
        doc.markdown(
            area = "auto",
            resource = world_ref("cockpit_doc"),
        ),
    ],
)
