app(
    id = "05-chart",
    title = "05 Chart",
    entries = [
        entry(scene = "main.mei", id = "home", title = "05 Chart"),
    ],
)

scene(
    id = "home",
    profile = "chart",
    summary = "独立图表示例：验证同一份 world dataset 的多图观察。",
)

world(
    resources = [
        resource(
            id = "chart_doc",
            kind = "document",
            title = "图表说明",
            content = "## Chart 例子\n\n这个例子验证：\n1. chart 组件先以外部扩展接入；\n2. 同一份 dataset 可被 table 与多个 chart 观察面同时消费；\n3. 当前仍是 `world_ref(dataset) -> component` 的过渡链路；\n4. 后续应逐步进入更稳定的 metric / mapping / brick contract。",
        ),
        resource(
            id = "monthly_data",
            kind = "dataset",
            title = "月度经营数据",
            source = ds.csv(path = "data/monthly_sales.csv"),
        ),
    ],
)

frame(
    title = "05 Chart",
    layout = grid(
        columns = ["1fr", "2fr"],
        rows = ["auto", "minmax(220px, 1fr)"],
        areas = [
            ["doc", "chart_revenue"],
            ["table", "chart_orders"],
        ],
        gap = "16px",
        padding = "20px",
    ),
)

panel(
    id = "doc_panel",
    title = "默认说明观察面",
    area = "doc",
    blocks = [
        doc.markdown(
            area = "auto",
            resource = world_ref("chart_doc"),
        ),
    ],
)

panel(
    id = "chart_revenue_panel",
    title = "营收观察（过渡态）",
    area = "chart_revenue",
    blocks = [
        component(
            "chart.bar-mini",
            area = "auto",
            props = {
                "title": "月度营收",
                "dataset": world_ref("monthly_data"),
                "labelField": "month",
                "valueField": "revenue",
            },
        ),
    ],
)

panel(
    id = "table_panel",
    title = "表格观察（默认 view）",
    area = "table",
    blocks = [
        component(
            "dataset.table",
            area = "auto",
            props = {
                "dataset": world_ref("monthly_data"),
            },
        ),
    ],
)

panel(
    id = "chart_orders_panel",
    title = "订单观察（过渡态）",
    area = "chart_orders",
    blocks = [
        component(
            "chart.bar-mini",
            area = "auto",
            props = {
                "title": "月度订单",
                "dataset": world_ref("monthly_data"),
                "labelField": "month",
                "valueField": "orders",
            },
        ),
    ],
)
