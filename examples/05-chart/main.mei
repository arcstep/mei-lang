app(
    id = "05-chart",
    title = "05 Chart",
    default_scene = "home",
)

app.add_scene(
    id = "home",
    profile = "chart",
    summary = "app 直接拥有 scene 的独立图表示例：验证同一份 world dataset 的多图观察。",
)

scene.set_world(
    resources = [
        resource(
            id = "chart_doc",
            kind = "document",
            title = "图表说明",
            content = "## Chart 例子\n\n这个例子验证：\n1. `chart.*` 组件仍走第一方外部扩展；\n2. 图表输入优先消费 `metric_ref(...)`；\n3. 字段绑定统一走 `mapping`；\n4. table 与 chart 共享同一份 data contract。",
        ),
        resource(
            id = "monthly_data",
            kind = "dataset",
            title = "月度经营数据",
            source = ds.csv(path = "data/monthly_sales.csv"),
        ),
    ],
)

monthly_rows = ds.data_ref("monthly_data")

ds.dataset_view(
    id = "monthly_metrics",
    title = "月度图表指标",
    rowset = monthly_rows,
    schema = [
        ds.column("month", "string"),
        ds.column("revenue", "number", unit = "元"),
        ds.column("orders", "number", unit = "单"),
    ],
    metrics = [
        ds.dataframe(
            id = "revenue_by_month",
            label = "月度营收",
            schema = [
                ds.column("label", "string"),
                ds.column("value", "number", unit = "元"),
            ],
            value = ds.trend(monthly_rows, "month", value = "revenue", by = "month", agg = "sum"),
        ),
        ds.dataframe(
            id = "orders_by_month",
            label = "月度订单",
            schema = [
                ds.column("label", "string"),
                ds.column("value", "number", unit = "单"),
            ],
            value = ds.trend(monthly_rows, "month", value = "orders", by = "month", agg = "sum"),
        ),
    ],
)

scene.set_frame(
    layout = grid(
        columns = ["1fr", "2fr"],
        rows = ["auto", "minmax(220px, 1fr)"],
        areas = [
            ["doc", "chart_revenue"],
            ["table", "chart_orders"],
        ],
        gap = "16px",
        padding = "20px",
    ),
)

frame.add_panel(
    id = "doc_panel",
    area = "doc",
    blocks = [
        doc.markdown(
            area = "auto",
            resource = world_ref("chart_doc"),
        ),
    ],
)

frame.add_panel(
    id = "chart_revenue_panel",
    area = "chart_revenue",
    blocks = [
        component(
            "chart.bar-mini",
            area = "auto",
            props = {
                "title": "月度营收",
                "data": ds.metric_ref("revenue_by_month", from_dataset = "monthly_metrics"),
                "mapping": {
                    "x": [{"field": "label", "name": "月份"}],
                    "y": [{"field": "value", "name": "营收"}],
                },
            },
        ),
    ],
)

frame.add_panel(
    id = "table_panel",
    area = "table",
    blocks = [
        component(
            "dataset.table",
            area = "auto",
            props = {
                "data": ds.data_ref("monthly_metrics"),
            },
        ),
    ],
)

frame.add_panel(
    id = "chart_orders_panel",
    area = "chart_orders",
    blocks = [
        component(
            "chart.bar-mini",
            area = "auto",
            props = {
                "title": "月度订单",
                "data": ds.metric_ref("orders_by_month", from_dataset = "monthly_metrics"),
                "mapping": {
                    "x": [{"field": "label", "name": "月份"}],
                    "y": [{"field": "value", "name": "订单"}],
                },
            },
        ),
    ],
)
