app(
    id = "051-chart",
    title = "051 Chart",
    default_scene = "home",
    entries = [
        entry(id = "home", scene = "home", frame = "home_frame"),
    ],
)

scene(
    id = "home",
    world = "home_world",
    frame = "home_frame",
    profile = "chart",
    summary = "app 直接拥有 scene 的独立图表示例：验证同一份 world dataset 的多图观察。",
)

world(
    id = "home_world",
    resources = [
        resource(
            id = "chart_doc",
            kind = "document",
            title = "图表说明",
            content = "## Chart 完整回归\n\n覆盖 11 种 chart.* 图型、完整 mapping 通道与 legacy props 兼容：multi-metric、stack、percent、dataZoom、radar dimensions、boxplot raw。",
        ),
        resource(
            id = "monthly_data",
            kind = "dataset",
            title = "月度经营宽表",
            source = ds.csv(path = "data/chart_lab.csv"),
        ),
    ],
)

monthly_rows = ds.data_ref("monthly_data")

ds.dataset_view(
    id = "chart_lab",
    title = "图表实验视图",
    rowset = monthly_rows,
    schema = [
        ds.column("month", "string"),
        ds.column("region", "string"),
        ds.column("revenue", "number", unit = "元"),
        ds.column("orders", "number", unit = "单"),
        ds.column("cost", "number", unit = "元"),
        ds.column("quality", "number"),
        ds.column("speed", "number"),
        ds.column("satisfaction", "number"),
        ds.column("min", "number"),
        ds.column("q1", "number"),
        ds.column("median", "number"),
        ds.column("q3", "number"),
        ds.column("max", "number"),
    ],
    metrics = [
        ds.dataframe(
            id = "revenue_by_month",
            label = "月度营收",
            schema = [
                ds.column("label", "string"),
                ds.column("value", "number", unit = "元"),
            ],
            value = ds.trend(monthly_rows, date_field = "month", value = "revenue", by = "month", agg = "sum"),
        ),
        ds.dataframe(
            id = "orders_by_month",
            label = "月度订单",
            schema = [
                ds.column("label", "string"),
                ds.column("value", "number", unit = "单"),
            ],
            value = ds.trend(monthly_rows, date_field = "month", value = "orders", by = "month", agg = "sum"),
        ),
        ds.dataframe(
            id = "region_share",
            label = "区域营收占比",
            schema = [
                ds.column("label", "string"),
                ds.column("value", "number", unit = "元"),
            ],
            value = ds.group_by(monthly_rows, fields = ["region"], value = "revenue", agg = "sum"),
        ),
    ],
)

frame(
    id = "home_frame",
    layout = grid(
        columns = ["minmax(0, 2fr)", "minmax(280px, 360px)"],
        areas = [
            ["charts", "doc"],
            ["charts", "table"],
        ],
        gap = "16px",
        padding = "20px",
    ),
)

frame.add_panel(
    id = "doc_panel",
    area = "doc",
    blocks = [
        doc.markdown(
            area = "auto",
            resource = world_ref("chart_doc"),
        ),
    ],
)

frame.add_panel(
    id = "charts_panel",
    area = "charts",
    layout = grid(
        columns = ["repeat(auto-fit, minmax(300px, 1fr))"],
        gap = "16px",
    ),
    blocks = [
        component(
            "chart.line",
            area = "auto",
            props = {
                "title": "line 月度营收",
                "data": ds.metric_ref("revenue_by_month", from_dataset = "chart_lab"),
                "mapping": {
                    "x": [{"field": "label", "name": "月份"}],
                    "y": [{"field": "value", "name": "营收"}],
                },
            },
        ),
        component(
            "chart.area",
            area = "auto",
            props = {
                "title": "area 月度订单",
                "data": ds.metric_ref("orders_by_month", from_dataset = "chart_lab"),
                "mapping": {
                    "x": [{"field": "label", "name": "月份"}],
                    "y": [{"field": "value", "name": "订单"}],
                },
            },
        ),
        component(
            "chart.trend",
            area = "auto",
            props = {
                "title": "trend 月度营收",
                "data": ds.metric_ref("revenue_by_month", from_dataset = "chart_lab"),
                "mapping": {
                    "x": [{"field": "label", "name": "月份"}],
                    "y": [{"field": "value", "name": "营收"}],
                },
            },
        ),
        component(
            "chart.column",
            area = "auto",
            props = {
                "title": "column 多指标 stack + percent",
                "data": ds.data_ref("chart_lab"),
                "stack": True,
                "transform": {"mode": "percent"},
                "mapping": {
                    "x": [{"field": "month", "name": "月份"}],
                    "y": [
                        {"field": "revenue", "name": "营收"},
                        {"field": "cost", "name": "成本"},
                    ],
                    "group": [{"field": "region", "name": "区域"}],
                },
            },
        ),
        component(
            "chart.bar",
            area = "auto",
            props = {
                "title": "bar 区域订单",
                "data": ds.data_ref("chart_lab"),
                "mapping": {
                    "x": [{"field": "region", "name": "区域"}],
                    "y": [{"field": "orders", "name": "订单"}],
                },
            },
        ),
        component(
            "chart.pie",
            area = "auto",
            props = {
                "title": "pie 区域营收",
                "data": ds.metric_ref("region_share", from_dataset = "chart_lab"),
                "mapping": {
                    "label": [{"field": "label", "name": "区域"}],
                    "y": [{"field": "value", "name": "营收"}],
                },
            },
        ),
        component(
            "chart.donut",
            area = "auto",
            props = {
                "title": "donut 区域营收",
                "data": ds.metric_ref("region_share", from_dataset = "chart_lab"),
                "mapping": {
                    "label": [{"field": "label", "name": "区域"}],
                    "y": [{"field": "value", "name": "营收"}],
                },
            },
        ),
        component(
            "chart.rose",
            area = "auto",
            props = {
                "title": "rose 区域营收",
                "data": ds.metric_ref("region_share", from_dataset = "chart_lab"),
                "mapping": {
                    "label": [{"field": "label", "name": "区域"}],
                    "y": [{"field": "value", "name": "营收"}],
                },
            },
        ),
        component(
            "chart.scatter",
            area = "auto",
            props = {
                "title": "scatter 订单与营收",
                "data": ds.data_ref("chart_lab"),
                "mapping": {
                    "x": [{"field": "orders", "name": "订单"}],
                    "y": [{"field": "revenue", "name": "营收"}],
                    "size": [{"field": "cost", "name": "成本"}],
                    "color": [{"field": "region", "name": "区域"}],
                },
            },
        ),
        component(
            "chart.radar",
            area = "auto",
            props = {
                "title": "radar 区域体验评分",
                "data": ds.data_ref("chart_lab"),
                "dimensions": ["quality", "speed", "satisfaction"],
                "mapping": {
                    "label": [{"field": "region", "name": "区域"}],
                    "y": [
                        {"field": "quality", "name": "质量"},
                        {"field": "speed", "name": "时效"},
                        {"field": "satisfaction", "name": "满意度"},
                    ],
                },
            },
        ),
        component(
            "chart.boxplot",
            area = "auto",
            props = {
                "title": "boxplot 月度营收分布",
                "data": ds.data_ref("chart_lab"),
                "mapping": {
                    "x": [{"field": "month", "name": "月份"}],
                    "y": [{"field": "revenue", "name": "营收"}],
                    "boxplot": [
                        {"field": "min", "name": "min"},
                        {"field": "q1", "name": "q1"},
                        {"field": "median", "name": "median"},
                        {"field": "q3", "name": "q3"},
                        {"field": "max", "name": "max"},
                    ],
                },
            },
        ),
    ],
)

frame.add_panel(
    id = "table_panel",
    area = "table",
    blocks = [
        component(
            "dataset.table",
            area = "auto",
            props = {
                "data": ds.data_ref("chart_lab"),
            },
        ),
    ],
)
