app.add_scene(
    id = "home_default",
    summary = "劳务大屏默认样式对照：不声明 theme，组件直接消费 CSV dataset，不额外声明 dataset_view。",
)

scene.set_world(
    resources = [
        resource(
            id = "subcontract_raw",
            kind = "dataset",
            title = "劳务分包",
            source = ds.csv(path = "data/subcontract.csv"),
        ),
        resource(
            id = "ranking_left_raw",
            kind = "dataset",
            title = "左下排行",
            source = ds.csv(path = "data/ranking_left.csv"),
        ),
        resource(
            id = "ranking_right_raw",
            kind = "dataset",
            title = "右下排行",
            source = ds.csv(path = "data/ranking_right.csv"),
        ),
        resource(
            id = "persons_raw",
            kind = "dataset",
            title = "人员代发",
            source = ds.csv(path = "data/persons.csv"),
        ),
        resource(
            id = "kpis_raw",
            kind = "dataset",
            title = "顶部 KPI",
            source = ds.csv(path = "data/kpis.csv"),
        ),
        resource(
            id = "donut_visit_raw",
            kind = "dataset",
            title = "代发人次环形图",
            source = ds.csv(path = "data/donut_visit.csv"),
        ),
        resource(
            id = "donut_std_raw",
            kind = "dataset",
            title = "代发标准环形图",
            source = ds.csv(path = "data/donut_std.csv"),
        ),
    ],
)

APP_ASSET_BASE = "/workspace-app-assets/032-cockpit/assets/images"

COCKPIT_APP_ASSETS = {
    "header_center": APP_ASSET_BASE + "/header-center.svg",
    "header_center_overlay": APP_ASSET_BASE + "/header-center-overlay.svg",
    "header_tri_left": APP_ASSET_BASE + "/header-tri-left.svg",
    "header_tri_right": APP_ASSET_BASE + "/header-tri-right.svg",
    "weather_icon": APP_ASSET_BASE + "/weather-icon.svg",
}

body_columns_layout = grid(
    columns = ["minmax(260px, 28%)", "minmax(320px, 1.6fr)", "minmax(260px, 28%)"],
    areas = [
        ["left_col", "center_col", "right_col"],
    ],
    gap = "12px",
)

column_stack_layout = flex(direction = "column", gap = "12px")

def column_panel(id, area, blocks):
    return panel(
        id = id,
        area = area,
        layout = column_stack_layout,
        variant = "container",
        blocks = blocks,
    )

def section_panel(id, title, use, component_props = None, show_heading = None):
    return panel(
        id = id,
        title = title,
        show_heading = show_heading,
        blocks = [
            component(
                use,
                props = component_props if component_props != None else {},
            ),
        ],
    )

scene.set_frame(
    layout = grid(
        columns = ["1fr"],
        rows = ["92px", "minmax(0,1fr)"],
        areas = [
            ["header"],
            ["body"],
        ],
        gap = "12px",
        padding = "0 14px 16px",
    ),
    props = {
        "viewport": {
            "enabled": True,
            "design_width": 1920,
            "design_height": 1080,
            "scale_mode": "contain",
            "align": "top-center",
            "safe_inset": {
                "top": 12,
                "right": 16,
                "bottom": 12,
                "left": 16,
            },
        },
    },
)

frame.add_panel(
    id = "labor_header",
    title = "032 劳务大屏页头",
    area = "header",
    show_heading = False,
    blocks = [
        component(
            "cockpit.header-bar",
            props = {
                "temp": "28°C",
                "sky": "多云",
                "title": "默认设置的可视化大屏",
                "titleBandMinWidth": 648,
                "stripPad": 208,
                "assets": COCKPIT_APP_ASSETS,
            },
        ),
    ],
)

frame.add_panel(
    id = "labor_body",
    title = "032 劳务大屏主体",
    area = "body",
    layout = body_columns_layout,
    variant = "container",
    blocks = [
        column_panel(
            id = "labor_left_col",
            area = "left_col",
            blocks = [
                section_panel(
                    id = "labor_left_top",
                    title = "这是板块标题",
                    use = "cockpit.subcontract-table",
                    component_props = {
                        "subcontract": ds.data_ref("subcontract_raw"),
                        "dataset": ds.data_ref("subcontract_raw"),
                    },
                ),
                section_panel(
                    id = "labor_left_bottom",
                    title = "这是板块标题",
                    use = "cockpit.ranking-list",
                    component_props = {
                        "dataset": ds.data_ref("ranking_left_raw"),
                        "headers": ["字段名称一", "字段名称一", "字段名称一"],
                    },
                ),
            ],
        ),
        column_panel(
            id = "labor_center_col",
            area = "center_col",
            blocks = [
                section_panel(
                    id = "labor_center_top",
                    title = "中部上区",
                    use = "cockpit.center-top",
                    component_props = {
                        "kpis": ds.data_ref("kpis_raw"),
                    },
                    show_heading = False,
                ),
                section_panel(
                    id = "labor_center_donut",
                    title = "这是板块标题",
                    use = "cockpit.donut-summary",
                    component_props = {
                        "donutVisit": ds.data_ref("donut_visit_raw"),
                        "donutStd": ds.data_ref("donut_std_raw"),
                    },
                ),
                section_panel(
                    id = "labor_center_ratio",
                    title = "这是板块标题",
                    use = "cockpit.ratio-summary",
                ),
            ],
        ),
        column_panel(
            id = "labor_right_col",
            area = "right_col",
            blocks = [
                section_panel(
                    id = "labor_right_top",
                    title = "这是板块标题",
                    use = "cockpit.person-cards",
                    component_props = {
                        "dataset": ds.data_ref("persons_raw"),
                        "monthLabel": "7月",
                    },
                ),
                section_panel(
                    id = "labor_right_bottom",
                    title = "这是板块标题",
                    use = "cockpit.ranking-list",
                    component_props = {
                        "dataset": ds.data_ref("ranking_right_raw"),
                        "headers": ["字段名称一", "字段名称一"],
                    },
                ),
            ],
        ),
    ],
)
