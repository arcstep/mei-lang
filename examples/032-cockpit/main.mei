app(
    id = "032-cockpit",
    title = "032 劳务大屏",
    default_scene = "home",
)

app.add_scene(
    id = "home",
    profile = "cockpit",
    summary = "劳务大屏迁移阶段 3：header panel 拆分 + 多组件标题区 + 中部双环形图数据驱动。",
)

scene.set_world(
    resources = [
        resource(
            id = "labor_doc",
            kind = "document",
            title = "迁移说明",
            content = "## 032 劳务大屏\n\n- **阶段 1**：`cockpit.labor-dashboard` 壳层与数据绑定。\n- **阶段 2**：板块标题 / 表与排行 / 人员卡 / KPI 子组件化，中部 **双环形图** 使用 `mei-chart-donut` + `data/donut_*.csv`。\n- **阶段 3（当前）**：将大标题区升级为 `frame -> header panel / main panel -> 多组件` 结构，验证 `panel` 背景与组件托底组合能力。\n- **后续**：合同数字格与底部指标绑定真实 dataset。",
        ),
        resource(
            id = "subcontract_raw",
            kind = "dataset",
            title = "劳务分包",
            source = ds.csv(path = "data/subcontract.csv"),
        ),
        resource(
            id = "ranking_left_raw",
            kind = "dataset",
            title = "左下排行",
            source = ds.csv(path = "data/ranking_left.csv"),
        ),
        resource(
            id = "ranking_right_raw",
            kind = "dataset",
            title = "右下排行",
            source = ds.csv(path = "data/ranking_right.csv"),
        ),
        resource(
            id = "persons_raw",
            kind = "dataset",
            title = "人员代发",
            source = ds.csv(path = "data/persons.csv"),
        ),
        resource(
            id = "kpis_raw",
            kind = "dataset",
            title = "顶部 KPI",
            source = ds.csv(path = "data/kpis.csv"),
        ),
        resource(
            id = "donut_visit_raw",
            kind = "dataset",
            title = "代发人次环形图",
            source = ds.csv(path = "data/donut_visit.csv"),
        ),
        resource(
            id = "donut_std_raw",
            kind = "dataset",
            title = "代发标准环形图",
            source = ds.csv(path = "data/donut_std.csv"),
        ),
    ],
)

sub_rows = ds.data_ref("subcontract_raw")
rank_l_rows = ds.data_ref("ranking_left_raw")
rank_r_rows = ds.data_ref("ranking_right_raw")
person_rows = ds.data_ref("persons_raw")
kpi_rows = ds.data_ref("kpis_raw")
donut_visit_rows = ds.data_ref("donut_visit_raw")
donut_std_rows = ds.data_ref("donut_std_raw")

ds.dataset_view(
    id = "labor_subcontract_view",
    title = "劳务分包视图",
    rowset = sub_rows,
    schema = [
        ds.column("category", "string"),
        ds.column("company", "string"),
        ds.column("amount", "string"),
    ],
)

ds.dataset_view(
    id = "labor_ranking_left_view",
    title = "左下排行视图",
    rowset = rank_l_rows,
    schema = [
        ds.column("rank", "string"),
        ds.column("col_a", "string"),
        ds.column("col_b", "string"),
        ds.column("col_c", "string"),
        ds.column("bar_pct", "number"),
    ],
)

ds.dataset_view(
    id = "labor_ranking_right_view",
    title = "右下排行视图",
    rowset = rank_r_rows,
    schema = [
        ds.column("rank", "string"),
        ds.column("col_a", "string"),
        ds.column("col_b", "string"),
        ds.column("col_c", "string"),
        ds.column("bar_pct", "number"),
    ],
)

ds.dataset_view(
    id = "labor_persons_view",
    title = "人员卡片视图",
    rowset = person_rows,
    schema = [
        ds.column("name", "string"),
        ds.column("days", "string"),
        ds.column("company", "string"),
        ds.column("month_amt", "string"),
        ds.column("total_amt", "string"),
    ],
)

ds.dataset_view(
    id = "labor_kpis_view",
    title = "KPI 视图",
    rowset = kpi_rows,
    schema = [
        ds.column("label", "string"),
        ds.column("value", "string"),
        ds.column("unit", "string"),
    ],
)

ds.dataset_view(
    id = "labor_donut_visit_view",
    title = "代发人次切片",
    rowset = donut_visit_rows,
    schema = [
        ds.column("label", "string"),
        ds.column("value", "number"),
    ],
)

ds.dataset_view(
    id = "labor_donut_std_view",
    title = "代发标准切片",
    rowset = donut_std_rows,
    schema = [
        ds.column("label", "string"),
        ds.column("value", "number"),
    ],
)

panel_shell_bare_props = {
    "show_heading": False,
    "background": {
        "color": "rgba(3,10,20,.76)",
        "image": "radial-gradient(120% 100% at 0% 0%, rgba(34,211,238,.10), transparent 36%), radial-gradient(120% 100% at 100% 0%, rgba(59,130,246,.08), transparent 34%), linear-gradient(180deg, rgba(8,28,48,.92) 0%, rgba(4,16,30,.9) 58%, rgba(2,10,20,.94) 100%)",
        "position": "center",
        "size": "cover",
        "repeat": "no-repeat",
    },
    "border": "1px solid rgba(56,189,248,.14)",
    "radius": "6px",
    "box_shadow": "inset 0 1px 0 rgba(125,211,252,.08), inset 0 0 0 1px rgba(15,23,42,.22), 0 10px 24px rgba(2,8,23,.24)",
    "padding": "0",
    "overflow": "hidden",
}

panel_shell_titled_props = {
    "background": {
        "color": "rgba(3,10,20,.76)",
        "image": "radial-gradient(120% 100% at 0% 0%, rgba(34,211,238,.10), transparent 36%), radial-gradient(120% 100% at 100% 0%, rgba(59,130,246,.08), transparent 34%), linear-gradient(180deg, rgba(8,28,48,.92) 0%, rgba(4,16,30,.9) 58%, rgba(2,10,20,.94) 100%)",
        "position": "center",
        "size": "cover",
        "repeat": "no-repeat",
    },
    "border": "1px solid rgba(56,189,248,.14)",
    "radius": "6px",
    "box_shadow": "inset 0 1px 0 rgba(125,211,252,.08), inset 0 0 0 1px rgba(15,23,42,.22), 0 10px 24px rgba(2,8,23,.24)",
    "padding": "0",
    "overflow": "hidden",
    "heading": {
        "variant": "screen",
        "accent": True,
        "flair": True,
        "dots": True,
    },
}

panel_container_props = {
    "show_heading": False,
    "background": "transparent",
    "border": "none",
    "radius": "0",
    "box_shadow": "none",
    "padding": "0",
    "overflow": "visible",
}

body_columns_layout = grid(
    columns = ["minmax(260px, 28%)", "minmax(320px, 1.6fr)", "minmax(260px, 28%)"],
    rows = ["1fr"],
    areas = [
        ["left_col", "center_col", "right_col"],
    ],
    gap = "12px",
    padding = "0",
)

left_column_layout = flex(direction = "column", gap = "12px", padding = "0")

center_column_layout = flex(direction = "column", gap = "12px", padding = "0")

right_column_layout = flex(direction = "column", gap = "12px", padding = "0")

scene.set_frame(
    layout = grid(
        columns = ["1fr"],
        rows = ["92px", "minmax(0,1fr)"],
        areas = [
            ["header"],
            ["body"],
        ],
        gap = "12px",
        padding = "0 14px 16px",
    ),
    props = {
        "viewport": {
            "enabled": True,
            "design_width": 1920,
            "design_height": 1080,
            "scale_mode": "contain",
            "align": "top-center",
            "safe_inset": {
                "top": 12,
                "right": 16,
                "bottom": 12,
                "left": 16,
            },
        },
        "background": {
            "image": "radial-gradient(120% 80% at 50% -10%, rgba(14,165,233,.22), transparent 55%), radial-gradient(80% 50% at 100% 50%, rgba(59,130,246,.12), transparent 45%), linear-gradient(180deg, #050b14 0%, #0a1628 40%, #071018 100%)",
            "position": "center",
            "repeat": "no-repeat",
        },
        "border": "1px solid rgba(56,189,248,.18)",
        "radius": "8px",
        "overflow": "hidden",
        "padding": "0",
    },
)

frame.add_panel(
    id = "labor_header",
    title = "032 劳务大屏页头",
    area = "header",
    props = {
        "show_heading": False,
        "background": "linear-gradient(180deg, rgba(9,31,58,.96) 0%, rgba(6,24,45,.9) 52%, rgba(3,13,24,.86) 100%)",
        "border": "none",
        "radius": "0",
        "padding": "0 18px",
        "box_shadow": "inset 0 -1px 0 rgba(94,212,255,.18), 0 18px 36px rgba(2,8,23,.25)",
        "overflow": "hidden",
        "min_height": "92px",
    },
    blocks = [
        component(
            "cockpit.labor-header-bar",
            props = {
                "temp": "28°C",
                "sky": "多云",
                "title": "这是标题可视化大屏",
                "titleBandMinWidth": 648,
                "stripPad": 208,
            },
        ),
    ],
)

frame.add_panel(
    id = "labor_body",
    title = "032 劳务大屏主体",
    area = "body",
    layout = body_columns_layout,
    props = panel_container_props,
    blocks = [
        panel(
            id = "labor_left_col",
            area = "left_col",
            layout = left_column_layout,
            props = panel_container_props,
            blocks = [
                panel(
                    id = "labor_left_top",
                    title = "这是板块标题",
                    area = "left_top",
                    props = panel_shell_titled_props,
                    blocks = [
                        component(
                            "cockpit.labor-subcontract-table",
                            props = {
                                "subcontract": ds.data_ref("labor_subcontract_view"),
                                "dataset": ds.data_ref("labor_subcontract_view"),
                            },
                        ),
                    ],
                ),
                panel(
                    id = "labor_left_bottom",
                    title = "这是板块标题",
                    area = "left_bottom",
                    props = panel_shell_titled_props,
                    blocks = [
                        component(
                            "cockpit.labor-ranking-list",
                            props = {
                                "dataset": ds.data_ref("labor_ranking_left_view"),
                                "headers": ["字段名称一", "字段名称一", "字段名称一"],
                            },
                        ),
                    ],
                ),
            ],
        ),
        panel(
            id = "labor_center_col",
            area = "center_col",
            layout = center_column_layout,
            props = panel_container_props,
            blocks = [
                panel(
                    id = "labor_center_top",
                    title = "中部上区",
                    area = "center_top",
                    props = panel_shell_bare_props,
                    blocks = [
                        component(
                            "cockpit.labor-center-top",
                            props = {
                                "kpis": ds.data_ref("labor_kpis_view"),
                            },
                        ),
                    ],
                ),
                panel(
                    id = "labor_center_donut",
                    title = "这是板块标题",
                    area = "center_donut",
                    props = panel_shell_titled_props,
                    blocks = [
                        component(
                            "cockpit.labor-donut-summary",
                            props = {
                                "donutVisit": ds.data_ref("labor_donut_visit_view"),
                                "donutStd": ds.data_ref("labor_donut_std_view"),
                            },
                        ),
                    ],
                ),
                panel(
                    id = "labor_center_ratio",
                    title = "这是板块标题",
                    area = "center_ratio",
                    props = panel_shell_titled_props,
                    blocks = [
                        component(
                            "cockpit.labor-ratio-summary",
                        ),
                    ],
                ),
            ],
        ),
        panel(
            id = "labor_right_col",
            area = "right_col",
            layout = right_column_layout,
            props = panel_container_props,
            blocks = [
                panel(
                    id = "labor_right_top",
                    title = "这是板块标题",
                    area = "right_top",
                    props = panel_shell_titled_props,
                    blocks = [
                        component(
                            "cockpit.labor-person-cards",
                            props = {
                                "dataset": ds.data_ref("labor_persons_view"),
                                "monthLabel": "7月",
                            },
                        ),
                    ],
                ),
                panel(
                    id = "labor_right_bottom",
                    title = "这是板块标题",
                    area = "right_bottom",
                    props = panel_shell_titled_props,
                    blocks = [
                        component(
                            "cockpit.labor-ranking-list",
                            props = {
                                "dataset": ds.data_ref("labor_ranking_right_view"),
                                "headers": ["字段名称一", "字段名称一"],
                            },
                        ),
                    ],
                ),
            ],
        ),
    ],
)
