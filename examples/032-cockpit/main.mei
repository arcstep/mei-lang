app(
    id = "032-cockpit",
    title = "032 劳务大屏",
    default_scene = "home",
)

app.add_scene(
    id = "home",
    profile = "cockpit",
    theme = "cockpit",
    summary = "劳务大屏主题对照：通过 theme 与 dataset_view 契约层组织作者态脚本。",
)

app.add_scene(
    scene_file_ref("default.mei", id = "home_default"),
)

scene.set_world(
    resources = [
        resource(
            id = "subcontract_raw",
            kind = "dataset",
            title = "劳务分包",
            source = ds.csv(path = "data/subcontract.csv"),
        ),
        resource(
            id = "ranking_left_raw",
            kind = "dataset",
            title = "左下排行",
            source = ds.csv(path = "data/ranking_left.csv"),
        ),
        resource(
            id = "ranking_right_raw",
            kind = "dataset",
            title = "右下排行",
            source = ds.csv(path = "data/ranking_right.csv"),
        ),
        resource(
            id = "persons_raw",
            kind = "dataset",
            title = "人员代发",
            source = ds.csv(path = "data/persons.csv"),
        ),
        resource(
            id = "kpis_raw",
            kind = "dataset",
            title = "顶部 KPI",
            source = ds.csv(path = "data/kpis.csv"),
        ),
        resource(
            id = "donut_visit_raw",
            kind = "dataset",
            title = "代发人次环形图",
            source = ds.csv(path = "data/donut_visit.csv"),
        ),
        resource(
            id = "donut_std_raw",
            kind = "dataset",
            title = "代发标准环形图",
            source = ds.csv(path = "data/donut_std.csv"),
        ),
    ],
)

# theme-first 对照：先引入原始 CSV dataset，再通过 dataset_view 固化 UI 消费契约。
sub_rows = ds.data_ref("subcontract_raw")
rank_l_rows = ds.data_ref("ranking_left_raw")
rank_r_rows = ds.data_ref("ranking_right_raw")
person_rows = ds.data_ref("persons_raw")
kpi_rows = ds.data_ref("kpis_raw")
donut_visit_rows = ds.data_ref("donut_visit_raw")
donut_std_rows = ds.data_ref("donut_std_raw")

ds.dataset_view(
    id = "labor_subcontract_view",
    title = "劳务分包视图",
    rowset = sub_rows,
    schema = [
        ds.column("category", "string"),
        ds.column("company", "string"),
        ds.column("amount", "string"),
    ],
)

ds.dataset_view(
    id = "labor_ranking_left_view",
    title = "左下排行视图",
    rowset = rank_l_rows,
    schema = [
        ds.column("rank", "string"),
        ds.column("col_a", "string"),
        ds.column("col_b", "string"),
        ds.column("col_c", "string"),
        ds.column("bar_pct", "number"),
    ],
)

ds.dataset_view(
    id = "labor_ranking_right_view",
    title = "右下排行视图",
    rowset = rank_r_rows,
    schema = [
        ds.column("rank", "string"),
        ds.column("col_a", "string"),
        ds.column("col_b", "string"),
        ds.column("col_c", "string"),
        ds.column("bar_pct", "number"),
    ],
)

ds.dataset_view(
    id = "labor_persons_view",
    title = "人员卡片视图",
    rowset = person_rows,
    schema = [
        ds.column("name", "string"),
        ds.column("days", "string"),
        ds.column("company", "string"),
        ds.column("month_amt", "string"),
        ds.column("total_amt", "string"),
    ],
)

ds.dataset_view(
    id = "labor_kpis_view",
    title = "KPI 视图",
    rowset = kpi_rows,
    schema = [
        ds.column("label", "string"),
        ds.column("value", "string"),
        ds.column("unit", "string"),
    ],
)

ds.dataset_view(
    id = "labor_donut_visit_view",
    title = "代发人次切片",
    rowset = donut_visit_rows,
    schema = [
        ds.column("label", "string"),
        ds.column("value", "number"),
    ],
)

ds.dataset_view(
    id = "labor_donut_std_view",
    title = "代发标准切片",
    rowset = donut_std_rows,
    schema = [
        ds.column("label", "string"),
        ds.column("value", "number"),
    ],
)

theme(
    id = "cockpit",
    font = {
        "1": "12px",
        "2": "14px",
        "3": "18px",
        "4": "40px",
    },
    tokens = {
        "color": {
            "text_primary": "#d8f0ff",
            "text_muted": "#94a3b8",
            "text_accent": "#fde68a",
        },
        "panel": {
            "padding": "12px",
            "radius": "6px",
        },
    },
)

body_columns_layout = grid(
    columns = ["minmax(260px, 28%)", "minmax(320px, 1.6fr)", "minmax(260px, 28%)"],
    areas = [
        ["left_col", "center_col", "right_col"],
    ],
    gap = "12px",
)

column_stack_layout = flex(direction = "column", gap = "12px")

def column_panel(id, area, blocks):
    return panel(
        id = id,
        area = area,
        layout = column_stack_layout,
        variant = "container",
        blocks = blocks,
    )

def section_panel(id, title, use, component_props = None, show_heading = None):
    return panel(
        id = id,
        title = title,
        show_heading = show_heading,
        blocks = [
            component(
                use,
                props = component_props if component_props != None else {},
            ),
        ],
    )

scene.set_frame(
    layout = grid(
        columns = ["1fr"],
        rows = ["92px", "minmax(0,1fr)"],
        areas = [
            ["header"],
            ["body"],
        ],
        gap = "12px",
        padding = "0 14px 16px",
    ),
    props = {
        "viewport": {
            "enabled": True,
            "design_width": 1920,
            "design_height": 1080,
            "scale_mode": "contain",
            "align": "top-center",
            "safe_inset": {
                "top": 12,
                "right": 16,
                "bottom": 12,
                "left": 16,
            },
        },
    },
)

frame.add_panel(
    id = "labor_header",
    title = "032 劳务大屏页头",
    area = "header",
    show_heading = False,
    props = {
        "background": "linear-gradient(180deg, rgba(9,31,58,.96) 0%, rgba(6,24,45,.9) 52%, rgba(3,13,24,.86) 100%)",
        "padding": "0",
    },
    blocks = [
        component(
            "cockpit.header-bar",
            props = {
                "temp": "28°C",
                "sky": "多云",
                "title": "这是标题可视化大屏",
                "titleBandMinWidth": 648,
                "stripPad": 208,
            },
        ),
    ],
)

frame.add_panel(
    id = "labor_body",
    title = "032 劳务大屏主体",
    area = "body",
    layout = body_columns_layout,
    variant = "container",
    blocks = [
        column_panel(
            id = "labor_left_col",
            area = "left_col",
            blocks = [
                section_panel(
                    id = "labor_left_top",
                    title = "这是板块标题",
                    use = "cockpit.subcontract-table",
                    component_props = {
                        "subcontract": ds.data_ref("labor_subcontract_view"),
                        "dataset": ds.data_ref("labor_subcontract_view"),
                    },
                ),
                section_panel(
                    id = "labor_left_bottom",
                    title = "这是板块标题",
                    use = "cockpit.ranking-list",
                    component_props = {
                        "dataset": ds.data_ref("labor_ranking_left_view"),
                        "headers": ["字段名称一", "字段名称一", "字段名称一"],
                    },
                ),
            ],
        ),
        column_panel(
            id = "labor_center_col",
            area = "center_col",
            blocks = [
                section_panel(
                    id = "labor_center_top",
                    title = "中部上区",
                    use = "cockpit.center-top",
                    component_props = {
                        "kpis": ds.data_ref("labor_kpis_view"),
                    },
                    show_heading = False,
                ),
                section_panel(
                    id = "labor_center_donut",
                    title = "这是板块标题",
                    use = "cockpit.donut-summary",
                    component_props = {
                        "donutVisit": ds.data_ref("labor_donut_visit_view"),
                        "donutStd": ds.data_ref("labor_donut_std_view"),
                    },
                ),
                section_panel(
                    id = "labor_center_ratio",
                    title = "这是板块标题",
                    use = "cockpit.ratio-summary",
                ),
            ],
        ),
        column_panel(
            id = "labor_right_col",
            area = "right_col",
            blocks = [
                section_panel(
                    id = "labor_right_top",
                    title = "这是板块标题",
                    use = "cockpit.person-cards",
                    component_props = {
                        "dataset": ds.data_ref("labor_persons_view"),
                        "monthLabel": "7月",
                    },
                ),
                section_panel(
                    id = "labor_right_bottom",
                    title = "这是板块标题",
                    use = "cockpit.ranking-list",
                    component_props = {
                        "dataset": ds.data_ref("labor_ranking_right_view"),
                        "headers": ["字段名称一", "字段名称一"],
                    },
                ),
            ],
        ),
    ],
)
