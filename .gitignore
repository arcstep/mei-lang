/target*/
/.tailwind/
# ── 系统杂项（macOS / Windows）──
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

node_modules/
/test-results/
/e2e-reports/
# 仅离线内网构建时本地生成（见 mei-release/scripts/prepare-offline-vendor.sh）
/vendor/
/.cargo/config.toml

# 本地隐藏/临时目录（工具缓存、草稿落盘；勿入库，避免 release dirty）
/.cache/
/.tmp/

# Host perf：本地 ad-hoc 采样/报告（正式台账见 docs/archive/mei-lang-v1/benchmarks/*.jsonl）
/scripts/perf/perf-wave*.jsonl
/scripts/perf/perf-wave*-report.md
/scripts/**/perf-wave*.jsonl
/scripts/**/perf-wave*-report.md
# scenario 目录只保留 *.json 配置，采样输出勿落盘到此
/scripts/perf/scenarios/**/*.jsonl

# workspace runtime install 输出（见 docs/archive/mei-lang-v1/implementation/toolchain/14-workspace-local-environment-mode1-contract.md）
/.mei/
/runtime/
/start.sh

# Python 拆分脚本缓存
__pycache__/
*.py[cod]
*$py.class

# 本地 cargo target 编译前后对比快照（scripts/compare-build-snapshot.sh 输出）
/.build-snapshot-*.txt

# Desktop Viewer 编译物兜底（细则见 desktop/.gitignore）
/desktop/node_modules/
/desktop/src-tauri/target/
/desktop/src-tauri/gen/
/desktop/sidecars/bin/
/desktop/sidecars/app/
/desktop/sidecars/MANIFEST.json
/desktop/dist/
/dist/
target-centos7-glibc217/
# Official DuckDB prebuilt libs (scripts/desktop/fetch-libduckdb.sh)
/third_party/libduckdb/
