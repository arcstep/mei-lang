{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mei-viewer",
  "version": "2.7.0",
  "identifier": "dev.mei.viewer",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "python3 -m http.server 1420 --bind 127.0.0.1 --directory ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "mei-viewer",
        "width": 1100,
        "height": 920,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecars/bin": "sidecars/bin",
      "../sidecars/app": "sidecars/app",
      "../sidecars/stock": "sidecars/stock"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
