use template "cockpit/business-layouts" as biz
use template "cockpit/metric-card/macros" as metric
use template "cockpit/panel/shell-macros"

# 指标卡模板预览：直接展示 `grid + slot + content` 新主样板。

scene(
    id = "metric",
    world = "metric_world",
    frame = "metric_frame",
    profile = "cockpit",
    theme = "cockpit",
    summary = "slot 皮肤 + metric 内容模板预览。",
)

world(id = "metric_world", resources = [])

METRIC_ASSETS = "/workspace-app-assets/templates/cockpit/assets/metrics"
ICON_TODO = METRIC_ASSETS + "/待办@3x.png"
ICON_DOING = METRIC_ASSETS + "/在办@3x.png"
ICON_DONE = METRIC_ASSETS + "/已办@3x.png"

PREVIEW_BODY_PROPS = {
    "width": "520px",
    "height": "auto",
    "min_height": "0",
    "box_sizing": "border-box",
    "overflow": "visible",
}

frame(
    id = "metric_frame",
    layout = grid(
        rows = ["1fr", "1fr", "1fr", "1fr", "1fr", "1fr", "1fr", "1fr"],
        columns = ["1fr"],
        areas = [
            ["block_narrow"],
            ["block_compound"],
            ["block_long"],
            ["block_progress"],
            ["block_solid_row"],
            ["block_solid_stack"],
            ["block_icon_left"],
            ["block_strip"],
        ],
        gap = "16px",
        padding = "16px",
        align = "start",
        justify = "center",
    ),
    props = {
        "width": "560px",
        "max_width": "560px",
        "min_height": "0",
        "height": "auto",
        "margin": "0 auto",
        "box_sizing": "border-box",
        "viewport": {"enabled": True, "design_width": 560, "fluid_height": True},
    },
    panels = [
        panel(
            id = "block_narrow",
            area = "block_narrow",
            shell = section_shell(
                title = "窄卡",
                width = "520px",
                body = panel(
                    id = "narrow_body",
                    variant = "container",
                    show_heading = False,
                    chrome = "bare",
                    props = PREVIEW_BODY_PROPS,
                    layout = grid(
                        rows = ["128px"],
                        columns = ["1fr", "1fr", "1fr"],
                        areas = [["normal", "selected", "desc"]],
                        gap = "6px",
                    ),
                    blocks = [
                        biz.narrow_metric_slot(
                            id = "preview_normal",
                            area = "normal",
                            source = {"label": "normal", "value": "2000", "unit": "项"},
                        ),
                        biz.narrow_metric_slot(
                            id = "preview_selected",
                            area = "selected",
                            source = {"label": "selected", "value": "1286", "unit": "人"},
                        ),
                        biz.desc_metric_slot(
                            id = "preview_stack_desc",
                            area = "desc",
                            desc = "目标 ≥50%",
                            source = {"label": "查实率", "value": "80", "unit": "%"},
                        ),
                    ],
                ),
            ),
        ),

        panel(
            id = "block_compound",
            area = "block_compound",
            shell = section_shell(
                title = "宽卡",
                width = "520px",
                body = panel(
                    id = "compound_body",
                    variant = "container",
                    show_heading = False,
                    chrome = "bare",
                    props = PREVIEW_BODY_PROPS,
                    layout = grid(rows = ["80px"], columns = ["1fr"], areas = [["preview_compound"]]),
                    blocks = [
                        biz.wide_metric_compound_body(
                            id = "preview_compound",
                            area = "preview_compound",
                            main = metric_card(
                                template = metric.compound_top_row(),
                                id = "compound_top",
                                source = {"label": "执法对象", "value": "356", "unit": "个"},
                            ),
                            sub_a = metric_card(
                                template = metric.plain_metric(),
                                id = "compound_b0",
                                variant = "sub",
                                source = {"label": "企业", "value": "210", "unit": "家"},
                            ),
                            sub_b = metric_card(
                                template = metric.plain_metric(),
                                id = "compound_b1",
                                variant = "sub",
                                source = {"label": "个人", "value": "98", "unit": "人"},
                            ),
                            sub_c = metric_card(
                                template = metric.plain_metric(),
                                id = "compound_b2",
                                variant = "sub",
                                source = {"label": "其他", "value": "48", "unit": "个"},
                            ),
                        ),
                    ],
                ),
            ),
        ),

        panel(
            id = "block_long",
            area = "block_long",
            shell = section_shell(
                title = "长卡",
                width = "520px",
                body = panel(
                    id = "long_body",
                    variant = "container",
                    show_heading = False,
                    chrome = "bare",
                    props = PREVIEW_BODY_PROPS,
                    layout = grid(rows = ["80px"], columns = ["1fr"], areas = [["preview_long"]]),
                    blocks = [
                        biz.long_metric_compound_body(
                            id = "preview_long",
                            area = "preview_long",
                            main = metric_card(
                                template = metric.plain_metric(),
                                id = "long_main",
                                area = "main",
                                source = {"label": "执法对象", "value": "356", "unit": "个"},
                            ),
                            top = metric_card(
                                template = metric.compound_top_row(),
                                id = "long_rtop",
                                area = "rtop",
                                variant = "sub",
                                source = {"label": "企业", "value": "210", "unit": "家"},
                            ),
                            bottom = metric_card(
                                template = metric.compound_top_row(),
                                id = "long_rbottom",
                                area = "rbottom",
                                variant = "sub",
                                source = {"label": "个人", "value": "98", "unit": "人"},
                            ),
                        ),
                    ],
                ),
            ),
        ),

        panel(
            id = "block_progress",
            area = "block_progress",
            shell = section_shell(
                title = "进度",
                width = "520px",
                body = panel(
                    id = "progress_body",
                    variant = "container",
                    show_heading = False,
                    chrome = "bare",
                    props = PREVIEW_BODY_PROPS,
                    layout = grid(
                        rows = ["104px", "104px"],
                        columns = ["1fr"],
                        areas = [["preview_progress"], ["preview_progress_patch"]],
                        gap = "6px",
                    ),
                    blocks = [
                        biz.progress_metric_slot(
                            id = "preview_progress",
                            area = "preview_progress",
                            desc = "80%",
                            source = {"label": "无违规", "value": "150", "unit": "次"},
                        ),
                        biz.progress_metric_slot(
                            id = "preview_progress_patch",
                            area = "preview_progress_patch",
                            desc = "65%",
                            source = {"label": "无违规", "value": "150", "unit": "次"},
                        ),
                    ],
                ),
            ),
        ),

        panel(
            id = "block_solid_row",
            area = "block_solid_row",
            shell = section_shell(
                title = "横排",
                width = "520px",
                body = panel(
                    id = "solid_row_body",
                    variant = "container",
                    show_heading = False,
                    chrome = "bare",
                    props = PREVIEW_BODY_PROPS,
                    layout = grid(
                        rows = ["50px", "32px"],
                        columns = ["1fr"],
                        areas = [["preview_row_accent"], ["preview_row_compact"]],
                        gap = "6px",
                    ),
                    blocks = [
                        biz.slot_metric_card(
                            id = "preview_row_accent",
                            area = "preview_row_accent",
                            template = metric.solid_row_accent(width = "100%", height = "100%"),
                            height_px = 50,
                            source = {"label": "总数", "value": "200", "unit": "次"},
                            shell_background = {"color": "rgba(98,190,235,0.10)"},
                            shell_border = "1px solid rgba(98,190,235,1)",
                        ),
                        biz.slot_metric_card(
                            id = "preview_row_compact",
                            area = "preview_row_compact",
                            template = metric.solid_row_compact(width = "100%", height = "100%"),
                            height_px = 32,
                            variant = "sub",
                            source = {"label": "近7日", "value": "20", "unit": "次"},
                            shell_border = "0.5px solid rgba(115,135,155,1)",
                        ),
                    ],
                ),
            ),
        ),

        panel(
            id = "block_solid_stack",
            area = "block_solid_stack",
            shell = section_shell(
                title = "叠排",
                width = "520px",
                body = panel(
                    id = "solid_stack_body",
                    variant = "container",
                    show_heading = False,
                    chrome = "bare",
                    props = PREVIEW_BODY_PROPS,
                    layout = grid(
                        rows = ["54px"],
                        columns = ["1fr", "1fr"],
                        areas = [["preview_stack_plain", "preview_stack_corner"]],
                        gap = "6px",
                    ),
                    blocks = [
                        biz.slot_metric_card(
                            id = "preview_stack_plain",
                            area = "preview_stack_plain",
                            template = metric.solid_stack(width = "100%", height = "100%", background = "transparent"),
                            height_px = 54,
                            source = {"label": "普通", "value": "200", "unit": "次"},
                            shell_background = {"color": "rgba(98,190,235,0.10)"},
                            shell_border = "1px solid rgba(98,190,235,0.35)",
                        ),
                        biz.slot_metric_card(
                            id = "preview_stack_corner",
                            area = "preview_stack_corner",
                            template = metric.solid_stack(width = "100%", height = "100%", background = "transparent"),
                            height_px = 54,
                            variant = "sub",
                            source = {"label": "角标", "value": "128", "unit": "件"},
                            shell_background = {"color": "rgba(98,190,235,0.10)"},
                            shell_border = "1px solid rgba(98,190,235,0.35)",
                        ),
                    ],
                ),
            ),
        ),

        panel(
            id = "block_icon_left",
            area = "block_icon_left",
            shell = section_shell(
                title = "左图",
                width = "520px",
                body = panel(
                    id = "icon_left_body",
                    variant = "container",
                    show_heading = False,
                    chrome = "bare",
                    props = PREVIEW_BODY_PROPS,
                    layout = grid(
                        rows = ["74px"],
                        columns = ["1fr", "1fr", "1fr"],
                        areas = [["todo", "doing", "done"]],
                        gap = "6px",
                    ),
                    blocks = [
                        biz.slot_metric_card(
                            id = "preview_icon_todo",
                            area = "todo",
                            template = metric.icon_left(width = "100%", height = "100%", icon_url = ""),
                            height_px = 74,
                            source = {"label": "待办", "value": "22", "unit": "件"},
                            shell_background = {
                                "color": "rgba(98,190,235,0.10)",
                                "image": "url(" + ICON_TODO + ")",
                                "size": "48px 48px",
                                "position": "11px center",
                                "repeat": "no-repeat",
                            },
                        ),
                        biz.slot_metric_card(
                            id = "preview_icon_doing",
                            area = "doing",
                            template = metric.icon_left(width = "100%", height = "100%", icon_url = ""),
                            height_px = 74,
                            source = {"label": "在办", "value": "18", "unit": "件"},
                            shell_background = {
                                "color": "rgba(98,190,235,0.10)",
                                "image": "url(" + ICON_DOING + ")",
                                "size": "48px 48px",
                                "position": "11px center",
                                "repeat": "no-repeat",
                            },
                        ),
                        biz.slot_metric_card(
                            id = "preview_icon_done",
                            area = "done",
                            template = metric.icon_left(width = "100%", height = "100%", icon_url = ""),
                            height_px = 74,
                            source = {"label": "已办", "value": "36", "unit": "件"},
                            shell_background = {
                                "color": "rgba(98,190,235,0.10)",
                                "image": "url(" + ICON_DONE + ")",
                                "size": "48px 48px",
                                "position": "11px center",
                                "repeat": "no-repeat",
                            },
                        ),
                    ],
                ),
            ),
        ),

        panel(
            id = "block_strip",
            area = "block_strip",
            shell = section_shell(
                title = "长条",
                width = "520px",
                body = panel(
                    id = "strip_body",
                    variant = "container",
                    show_heading = False,
                    chrome = "bare",
                    props = PREVIEW_BODY_PROPS,
                    layout = grid(rows = ["74px"], columns = ["1fr"], areas = [["preview_strip"]]),
                    blocks = [
                        biz.slot_metric_card(
                            id = "preview_strip",
                            area = "preview_strip",
                            template = metric.strip_icon_left(width = "100%", height = "100%", icon_url = "", padding = "0 16px 0 24px"),
                            height_px = 74,
                            source = {"label": "查实率", "value": "80", "unit": "%"},
                            shell_background = {
                                "color": "rgba(98,190,235,0.10)",
                                "image": "url(" + ICON_DONE + ")",
                                "size": "48px 48px",
                                "position": "24px center",
                                "repeat": "no-repeat",
                            },
                        ),
                    ],
                ),
            ),
        ),
    ],
)
