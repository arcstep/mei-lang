# 大屏顶栏 panel 模板（1920×72 设计稿逻辑尺寸）。
# 图层：screen-title-bg（全宽底纹）+ screen-title-center（居中帽檐，随标题 ResizeObserver 加宽）+ 主标题。
# 渲染由 cockpit.header-brand 负责；消费方可用 screen_header(...) 宏或 panel_ref 覆写 title。
# 板块内标题壳请用 section_shell（shell-macros.mei），勿与本顶栏混用。

scene(id = "panel_screen_header_tpl", profile = "cockpit", theme = "cockpit")

world(resources = [])

HEADER_ASSET_BASE = "/workspace-app-assets/templates/cockpit/assets/header"
SCREEN_HEADER_ASSETS = {
    "title_bg": HEADER_ASSET_BASE + "/screen-title-bg@3x.svg",
    "title_mid": HEADER_ASSET_BASE + "/screen-title-center@3x.svg",
}

HEADER_H = "72px"
DESIGN_W = 1920

frame(
    layout = grid(
        columns = ["1fr"],
        areas = [["main"]],
        gap = "0",
        padding = "0",
    ),
    props = {
        "viewport": {
            "enabled": True,
            "design_width": DESIGN_W,
            "design_height": 72,
            "fluid_height": True,
            "scale_mode": "contain",
            "align": "top-center",
            "safe_inset": {
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0,
            },
        },
        "height": HEADER_H,
        "min_height": HEADER_H,
        "max_height": HEADER_H,
        "box_sizing": "border-box",
        "overflow": "hidden",
    },
    panels = [
panel(
    id = "screen_header_shell",
    area = "main",
    variant = "container",
    show_heading = False,
    chrome = "bare",
    props = {
        "padding": "0",
        "background": "transparent",
        "border": "none",
        "width": "100%",
        "height": HEADER_H,
        "min_height": HEADER_H,
        "max_height": HEADER_H,
        "overflow": "hidden",
        "box_sizing": "border-box",
    },
    blocks = [
        component(
            "cockpit.header-brand",
            id = "screen_header_brand",
            props = {
                "title": "标题占位",
                "assets": SCREEN_HEADER_ASSETS,
                "capMinWidth": 633,
                "titleColor": "#E8F0FF",
                "titleLineHeight": "68px",
                "titleLetterSpacing": "0",
            },
        ),
    ],
),
    ],
)


