# stack_desc 查实率卡 150×128：顶 14px→label；value|unit 底距外框底 40px；desc 底 14px + 80×20 角标。
# 行轨合计 128px：14 + label(auto≈20) + 54 + 6 + 20 + 14。槽位水平居中。

scene(id = "metric_card_stack_desc_tpl", profile = "cockpit", theme = "cockpit")

world(resources = [])

METRIC_ASSET_BASE = "/workspace-app-assets/templates/cockpit/assets/metrics"
BG_MID = METRIC_ASSET_BASE + "/metric-bg-mid@3x.svg"

DESC_SHELL = {
    "width": "80px",
    "height": "20px",
    "background": "rgba(201, 233, 248, 0.2)",
    "border_radius": "2px",
    "font_family": "Microsoft YaHei, MicrosoftYaHei, PingFang SC, sans-serif",
    "font_size": "12px",
    "color": "rgba(255, 255, 255, 0.8)",
    "letter_spacing": "0",
    "font_weight": "400",
}

frame(
    panels = [
panel(
    id = "card_stack_desc_mid",
    area = "auto",
    show_heading = False,
    chrome = "bare",
    variant = "container",
    props = {
        "chrome": "bare",
        "padding": "0 8px",
        "width": "150px",
        "height": "128px",
        "box_sizing": "border-box",
        "overflow": "hidden",
        "__mei_metric_card": True,
        "__mei_metric_density": "normal",
        "__mei_metric_template": "stack_desc",
        "__mei_metric_inline_align": "compact",
        "__mei_metric_label_v_align": "center",
        "__mei_metric_value_v_align": "end",
        "__mei_metric_unit_v_align": "end",
        "__mei_metric_desc_v_align": "center",
        # 勿再加 CSS 描边/底色，SVG 已含边框与填充（与进度卡 metric-bg-clean 同理）。
        "background": {
            "image": "url(" + BG_MID + ")",
            "size": "100% 100%",
            "position": "center",
            "repeat": "no-repeat",
        },
    },
    layout = grid(
        rows = ["14px", "auto", "54px", "6px", "20px", "14px"],
        columns = ["auto", "auto"],
        areas = [
            [".", "."],
            ["label", "label"],
            ["value", "unit"],
            [".", "."],
            ["desc", "desc"],
            [".", "."],
        ],
        gap = "0",
        align = "stretch",
        justify = "center",
    ),
    blocks = [
        label("查实率", area = "label", align = "center", vertical_align = "center"),
        value("80", area = "value", align = "center", vertical_align = "end"),
        unit("%", area = "unit", align = "center", vertical_align = "end"),
        component(
            "mei.text",
            area = "desc",
            props = {
                "content": "目标 ≥ 50%",
                "metric_role": "desc",
                "metric_v_align": "center",
                "align": "center",
                "desc_shell": DESC_SHELL,
            },
        ),
    ],
),
    ],
)


