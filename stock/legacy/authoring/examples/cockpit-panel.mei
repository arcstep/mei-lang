# Proof: section_shell as titled section host (content_panel will become content_panel).

use template "cockpit/panel/shell-macros"

app(
    id = "author-example-cockpit-panel",
    title = "Author Example Cockpit Panel",
    default_stage = "home",
)

scene(
    id = "home",
    world = "home_world",
    frame = "home_frame",
    profile = "cockpit",
    theme = "cockpit",
    summary = "Minimal section_shell example for the standalone author package.",
)

world(id = "home_world", resources = [])

frame(
    id = "home_frame",
    layout = grid(
        columns = ["1fr"],
        rows = ["1fr"],
        areas = [["main"]],
        gap = "16px",
        padding = "20px",
    ),
    panels = [
        panel(
            id = "summary_panel",
            area = "main",
            shell = section_shell(
                title = "Business Summary",
                width = "100%",
                body = panel(
                    id = "summary_body",
                    variant = "container",
                    show_heading = False,
                    chrome = "bare",
                    props = content_fill_props(),
                    blocks = [],
                ),
            ),
        ),
    ],
)
