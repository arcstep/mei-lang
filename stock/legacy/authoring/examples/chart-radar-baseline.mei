# Proof: chart.radar / chart.scatter multi-channel mapping.

app(
    id = "author-example-chart-radar",
    title = "Author Example Chart Radar",
    default_stage = "home",
)

scene(
    id = "home",
    world = "home_world",
    frame = "home_frame",
    profile = "chart",
    summary = "Radar and scatter chart preview examples.",
)

world(
    id = "home_world",
    resources = [
        resource(
            id = "radar_data",
            kind = "dataset",
            title = "Radar sample",
            source = ds.csv(path = "../../stock/authoring/examples/data/chart-radar.csv"),
        ),
        resource(
            id = "scatter_data",
            kind = "dataset",
            title = "Scatter sample",
            source = ds.csv(path = "../../stock/authoring/examples/data/chart-lab.csv"),
        ),
    ],
)

frame(
    id = "home_frame",
    layout = flex(direction = "column", gap = "16px", padding = "20px"),
    panels = [
panel(
    id = "radar_panel",
    area = "auto",
    blocks = [
        component(
            "chart.radar",
            area = "auto",
            props = {
                "title": "Multi metric radar",
                "data": dataset_ref(id = "radar_data"),
                "mapping": {
                    "label": [{"field": "series", "name": "Series"}],
                    "y": [
                        {"field": "speed", "name": "Speed"},
                        {"field": "quality", "name": "Quality"},
                        {"field": "cost", "name": "Cost"},
                        {"field": "uptime", "name": "Uptime"},
                    ],
                },
            },
        ),
    ],
),
panel(
    id = "scatter_panel",
    area = "auto",
    blocks = [
        component(
            "chart.scatter",
            area = "auto",
            props = {
                "title": "Revenue vs orders",
                "data": dataset_ref(id = "scatter_data"),
                "mapping": {
                    "x": [{"field": "revenue", "name": "Revenue"}],
                    "y": [{"field": "orders", "name": "Orders"}],
                    "label": [{"field": "region", "name": "Region"}],
                },
            },
        ),
    ],
),
    ],
)


