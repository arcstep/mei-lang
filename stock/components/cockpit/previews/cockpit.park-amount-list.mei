app(id="preview-cockpit-park-amount-list", title="Preview cockpit.park-amount-list", default_stage="home")
scene(id="home", world="home_world", frame="home_frame", profile="cockpit", theme="cockpit", summary="Pack preview")
world(id="home_world", resources=[])
frame(id="home_frame", layout=flex(direction="column", gap="16px", padding="20px"),
    panels = [
panel(id="main", area="auto", blocks=[
    component("cockpit.park-amount-list", area="auto", props={"items": [{"name": "Park A", "amount": 1200}]}),
]),
    ],
)


