app(id="preview-sim-board-grid", title="Preview sim.board-grid", default_scene="home")
scene(id="home", world="home_world", frame="home_frame", profile="page", summary="Pack preview")
world(id="home_world", resources=[])
frame(id="home_frame", layout=flex(direction="column", gap="16px", padding="20px"))
frame.add_panel(id="main", area="auto", blocks=[
    component("sim.board-grid", area="auto", props={"rows": 3, "cols": 3}),
])

