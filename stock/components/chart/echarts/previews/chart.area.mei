# Pack preview: chart.area

app(
    id = "preview-chart-area",
    title = "Preview chart.area",
    default_stage = "home",
)

scene(
    id = "home",
    world = "home_world",
    frame = "home_frame",
    profile = "chart",
    summary = "Pack-local build preview for chart.area.",
)

world(
    id = "home_world",
    resources = [
        resource(
            id = "chart_data",
            kind = "dataset",
            title = "Chart sample",
            source = ds.csv(path = "../../stock/authoring/examples/data/chart-lab.csv"),
        ),
    ],
)

frame(
    id = "home_frame",
    layout = flex(direction = "column", gap = "16px", padding = "20px"),
    panels = [
panel(
    id = "main_panel",
    area = "auto",
    blocks = [
        component(
            "chart.area",
            area = "auto",
            props = {
                "title": "Revenue area",
                "data": dataset_ref(id = "chart_data"),
                "mapping": {
                    "x": [{"field": "month", "name": "Month"}],
                    "y": [{"field": "revenue", "name": "Revenue"}],
                    "group": [{"field": "region", "name": "Region"}],
                },
            }
        ),
    ],
),
    ],
)



