# Pack preview: chart.ranking

app(
    id = "preview-chart-ranking",
    title = "Preview chart.ranking",
    default_scene = "home",
)

scene(
    id = "home",
    world = "home_world",
    frame = "home_frame",
    profile = "chart",
    summary = "Pack-local build preview for chart.ranking.",
)

world(
    id = "home_world",
    resources = [
        resource(
            id = "chart_data",
            kind = "dataset",
            title = "Chart sample",
            source = ds.csv(path = "../../stock/authoring/examples/data/chart-composition.csv"),
        ),
    ],
)

frame(
    id = "home_frame",
    layout = flex(direction = "column", gap = "16px", padding = "20px"),
    panels = [
panel(
    id = "main_panel",
    area = "auto",
    blocks = [
        component(
            "chart.ranking",
            area = "auto",
            props = {
                "title": "Top items",
                "data": dataset_ref(id = "chart_data"),
                "mapping": {
                    "label": [{"field": "category", "name": "Category"}],
                    "y": [{"field": "revenue", "name": "Revenue"}],
                },
            }
        ),
    ],
),
    ],
)



