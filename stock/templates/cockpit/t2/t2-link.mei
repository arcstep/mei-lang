# T2 popup link 约定（窄模板）
#
# link_decl 必须保持顶层白名单构造器（不可由 template 调用顶层展开）。
# 本文件只提供可复用片段；作者仍显式写：
#
#   use template "cockpit/t2/t2-tab-session" as t2_tab
#   link_decl(
#       key = "...",
#       type = "popup",
#       projection = "overlay",
#       overlay_size = "large",
#       overlay_workspace = t2_tab.default_t2_tab_session(size = "large"),
#       target = assembly_ref("..."),
#       params = { ... },
#   )
#
# 行级下钻优先 `row_popup = link_ref(".../links/...")`，避免与 links.mei 平行维护 popup dict。

use template "cockpit/t2/t2-tab-session" as t2_tab

template default_overlay_workspace(size = "large"):
    t2_tab.default_t2_tab_session(size = size)

template default_overlay_size():
    "large"
