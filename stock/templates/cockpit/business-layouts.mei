template chart_with_summary_body(
    id = "chart_with_summary",
    area = "auto",
    primary = metric_source(label = "总数", value = "0", unit = "次"),
    secondary_a = metric_source(label = "近7日", value = "0", unit = "次"),
    secondary_b = metric_source(label = "子指标", value = "0", unit = "次"),
    chart = None,
    summary_width = "168px",
    gap = SPACE_MICRO_GAP,
):
    panel(
        id = id,
        area = area,
        variant = "container",
        show_heading = False,
        chrome = "bare",
        props = transparent_panel_props(),
        layout = grid(
            rows = ["1fr"],
            columns = [summary_width, "1fr"],
            areas = [["summary", "chart"]],
            gap = gap,
        ),
        blocks = [
            summary_stack_body(
                id = id + "_summary",
                area = "summary",
                primary = primary,
                secondary_a = secondary_a,
                secondary_b = secondary_b,
            ),
            panel(
                id = id + "_chart",
                area = "chart",
                variant = "container",
                show_heading = False,
                chrome = "bare",
                props = transparent_panel_props(),
                blocks = [chart],
            ),
        ],
    )

