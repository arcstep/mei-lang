use template "cockpit/metric-card/macros" as metric
use template "cockpit/panel/shell-macros" as shell

# 业务语义布局宏（Fill-down）
#
# 目的：
# - 用 workspace 宏表达「内容块 / 指标组 / 图表摘要 / 证据分栏」等业务意图
# - 不是结构树节点；展开为 panel + grid + metric/component
# - content 用 content_fill_props / 1fr，禁止 row_budgets 撑高

TPL_METRICS = "/workspace-app-assets/templates/cockpit/assets/metrics"
BG_MID = TPL_METRICS + "/metric-bg-mid@3x.svg"
BG_NORMAL = TPL_METRICS + "/metric-bg-normal@3x.svg"
BG_CLEAN = TPL_METRICS + "/metric-bg-clean@3x.svg"
BG_TARGET = TPL_METRICS + "/metric-bg-target@3x.svg"
BG_LONG = TPL_METRICS + "/metric-bg-long@3x.svg"

SPACE_MICRO_TITLE = "32px"
SPACE_MICRO_GAP = "6px"
SPACE_TABLE_GAP = "8px"
SPACE_STORY_GAP = "16px"
SPACE_METRIC_LIST_PAD = "4px 6px"
SPACE_COMPOUND_GAP = "2px"
DEBUG_MICRO_SHADOW = "var(--mei-layout-debug-micro-shadow, inset 0 0 0 0 transparent)"
METRIC_COMPACT74_PADDING = "10px 8px 10px 11px"
METRIC_SUMMARY100_PADDING = "2px 8px"
METRIC_SUMMARY32_PADDING = "0 8px"
METRIC_DESC128_PADDING = "0 8px"
METRIC_STRIP_SLOT_PAD = "5px 0"
# slot 背景：随 slot 盒拉伸铺满（非 contain / 非锁定 SVG 宽高比）
SLOT_BG_STRETCH_SIZE = "100% 100%"

SLOT_FRAME_BG_FLAG = {"__mei_slot_frame_bg": True}

# zhifa card_solid_stack_corner：四角 #71F1EA L 形装饰 + 半透明底
# Keep multi-layer shorthand (not structured object): slot-frame CSS forces
# background-size 100% 100% for SVG skins, which would stretch 4px corner ticks.
CORNER_DECOR_BG = "linear-gradient(#71F1EA,#71F1EA) left top / 4px 2px no-repeat,"
    + "linear-gradient(#71F1EA,#71F1EA) right top / 4px 2px no-repeat,"
    + "linear-gradient(#71F1EA,#71F1EA) left bottom / 4px 2px no-repeat,"
    + "linear-gradient(#71F1EA,#71F1EA) right bottom / 4px 2px no-repeat,"
    + "rgba(98,190,235,0.10)"

template slot_stretch_fill_layer(
    image,
):
    {
        "image": "url(" + image + ")",
        "size": SLOT_BG_STRETCH_SIZE,
        "position": "center",
        "repeat": "no-repeat",
        "origin": "border-box",
        "clip": "border-box",
    }

template metric_slot_background(
    image = BG_NORMAL,
):
    slot_stretch_fill_layer(image = image)

template compound_slot_background(
    image = BG_TARGET,
):
    {
        "color": "rgba(98,190,235,0.10)",
    } | slot_stretch_fill_layer(image = image)

template transparent_panel_props(
    padding = "0",
    background = "transparent",
    height = "100%",
):
    {
        "padding": padding,
        "background": background,
        "box_shadow": DEBUG_MICRO_SHADOW,
        "height": height,
        "min_height": "0",
        "box_sizing": "border-box",
        "overflow": "hidden",
    }

template semantic_shell_props(
    padding = "0",
    background = "rgba(14, 52, 96, 0.32)",
    border = "1px solid rgba(56, 160, 240, 0.20)",
    radius = "4px",
):
    {
        "padding": padding,
        "background": background,
        "border": border,
        "box_shadow": DEBUG_MICRO_SHADOW,
        "radius": radius,
        "height": "100%",
        "min_height": "0",
        "box_sizing": "border-box",
        "overflow": "hidden",
    }

template slot_metric_shell(
    id = "metric_slot",
    area = "auto",
    child = None,
    padding = "0",
    background = "transparent",
    border = "none",
    radius = "4px",
    width = "100%",
    height = "100%",
    shell_props = {},
):
    panel(
        id = id,
        area = area,
        variant = "container",
        show_heading = False,
        chrome = "bare",
        props = {
            "padding": padding,
            "background": background,
            "border": border,
            "radius": radius,
            "width": width,
            "height": height,
            "min_height": "0",
            "box_sizing": "border-box",
            "overflow": "hidden",
            "box_shadow": DEBUG_MICRO_SHADOW,
        } | shell_props,
        layout = grid(
            rows = ["1fr"],
            columns = ["1fr"],
            areas = [["content"]],
            gap = "0",
            align = "stretch",
        ),
        blocks = [child],
    )

template slot_metric_card(
    id = "metric_slot_card",
    area = "auto",
    layout_role = "plain",
    template = None,
    source = {"label": "指标", "value": "--", "unit": "", "desc": ""},
    desc = "",
    variant = None,
    height_px = None,
    shell_padding = "0",
    shell_height = "100%",
    shell_background = "transparent",
    shell_border = "none",
    shell_radius = "4px",
    shell_props = {},
    card_props = {},
    presentation = None,
    popup = None,
):
    slot_metric_shell(
        id = id,
        area = area,
        padding = shell_padding,
        background = shell_background,
        border = shell_border,
        radius = shell_radius,
        height = shell_height,
        shell_props = shell_props,
        child = metric(
            id = id + "_content",
            area = "content",
            layout_role = layout_role,
            variant = variant,
            height_px = height_px,
            source = source,
            desc = desc,
            presentation = presentation,
            popup = popup,
            props = {
                "width": "100%",
                "height": "100%",
                "min_height": "0",
                "background": "transparent",
                "border": "none",
                "box_shadow": "none",
            } | card_props,
        ),
    )

template solid_metric_fill_slot(
    id = "solid_metric_slot",
    area = "auto",
    source = {"label": "指标", "value": "--", "unit": "", "desc": ""},
    popup = None,
    presentation = None,
):
    slot_metric_card(
        id = id,
        area = area,
        layout_role = "solid_stack",
        source = source,
        popup = popup,
        presentation = presentation,
        shell_height = "100%",
        shell_background = CORNER_DECOR_BG,
        shell_border = "1px solid rgba(98,190,235,0.35)",
        shell_props = SLOT_FRAME_BG_FLAG,
        card_props = {"label_vertical_align": "center"},
    )

template narrow_metric_slot(
    id = "metric_narrow_slot",
    area = "auto",
    source = {"label": "指标", "value": "--", "unit": "", "desc": ""},
    variant = None,
    shell_padding = "0",
    shell_height = "100%",
):
    slot_metric_card(
        id = id,
        area = area,
        layout_role = "plain",
        source = source,
        variant = variant,
        shell_padding = shell_padding,
        shell_height = shell_height,
        shell_background = metric_slot_background(image = BG_NORMAL),
        shell_props = SLOT_FRAME_BG_FLAG,
    )

template desc_metric_slot(
    id = "metric_desc_slot",
    area = "auto",
    source = {"label": "指标", "value": "--", "unit": "", "desc": ""},
    desc = "",
    height_px = 128,
):
    slot_metric_card(
        id = id,
        area = area,
        layout_role = "stack_desc",
        desc = desc,
        source = source,
        height_px = height_px,
        shell_background = metric_slot_background(image = BG_MID),
        shell_props = SLOT_FRAME_BG_FLAG,
    )

template desc_metric_fill_slot(
    id = "metric_desc_slot",
    area = "auto",
    source = {"label": "指标", "value": "--", "unit": "", "desc": ""},
    desc = "",
):
    slot_metric_card(
        id = id,
        area = area,
        layout_role = "stack_desc",
        desc = desc,
        source = source,
        shell_height = "100%",
        shell_background = metric_slot_background(image = BG_MID),
        shell_props = SLOT_FRAME_BG_FLAG,
    )

template progress_metric_slot(
    id = "metric_progress_slot",
    area = "auto",
    source = {"label": "指标", "value": "--", "unit": "", "desc": ""},
    desc = "",
    variant = None,
    height_px = 104,
):
    slot_metric_card(
        id = id,
        area = area,
        layout_role = "stack_progress",
        desc = desc,
        source = source,
        variant = variant,
        height_px = height_px,
        shell_height = str(height_px) + "px",
        shell_background = metric_slot_background(image = BG_CLEAN),
        shell_props = SLOT_FRAME_BG_FLAG,
    )

template progress_metric_fill_slot(
    id = "metric_progress_slot",
    area = "auto",
    source = {"label": "指标", "value": "--", "unit": "", "desc": ""},
    desc = "",
    variant = None,
):
    slot_metric_card(
        id = id,
        area = area,
        layout_role = "stack_progress",
        desc = desc,
        source = source,
        variant = variant,
        shell_height = "100%",
        shell_background = metric_slot_background(image = BG_CLEAN),
        shell_props = SLOT_FRAME_BG_FLAG,
    )

template micro_title(title = "标题", area = "title"):
    component(
        "cockpit.panel-title",
        area = area,
        props = {"title": title},
    )

template metric_source(
    label = "指标",
    value = "--",
    unit = "",
    desc = "",
    presentation = None,
):
    {
        "label": label,
        "value": value,
        "unit": unit,
        "desc": desc,
        "presentation": presentation,
    }

# 语义内容块（原 micro_panel）：业务宏，不是结构树层级。
template content_block(
    id = "content_block",
    area = "auto",
    title = "内容块",
    body = None,
    title_height = SPACE_MICRO_TITLE,
    gap = SPACE_MICRO_GAP,
    background = "rgba(14, 52, 96, 0.32)",
    border = "1px solid rgba(56, 160, 240, 0.20)",
    body_padding = "0",
):
    panel(
        id = id,
        area = area,
        variant = "container",
        show_heading = False,
        chrome = "bare",
        props = semantic_shell_props(background = background, border = border),
        layout = grid(
            rows = [title_height, "1fr"],
            columns = ["1fr"],
            areas = [["title"], ["content"]],
            gap = gap,
        ),
        blocks = [
            micro_title(title = title, area = "title"),
            panel(
                id = id + "_content",
                area = "content",
                variant = "container",
                show_heading = False,
                chrome = "bare",
                props = transparent_panel_props(padding = body_padding),
                blocks = [body],
            ),
        ],
    )

template metric_triptych_body(
    id = "metric_triptych",
    area = "auto",
    first = metric_source(label = "指标A", value = "0", unit = "项"),
    second = metric_source(label = "指标B", value = "0", unit = "项"),
    third = metric_source(label = "指标C", value = "0", unit = "项"),
    gap = SPACE_MICRO_GAP,
    card_height = 86,
):
    panel(
        id = id,
        area = area,
        variant = "container",
        show_heading = False,
        chrome = "bare",
        props = transparent_panel_props(),
        layout = grid(
            rows = ["1fr"],
            columns = ["1fr", "1fr", "1fr"],
            areas = [["first", "second", "third"]],
            gap = gap,
        ),
        blocks = [
            slot_metric_card(
                id = id + "_first",
                area = "first",
                layout_role = "solid_stack",
                height_px = card_height,
                source = first,
                card_props = {"label_vertical_align": "center"},
                shell_background = CORNER_DECOR_BG,
                shell_border = "1px solid rgba(98,190,235,0.35)",
            ),
            slot_metric_card(
                id = id + "_second",
                area = "second",
                layout_role = "solid_stack",
                height_px = card_height,
                source = second,
                card_props = {"label_vertical_align": "center"},
                shell_background = CORNER_DECOR_BG,
                shell_border = "1px solid rgba(98,190,235,0.35)",
            ),
            slot_metric_card(
                id = id + "_third",
                area = "third",
                layout_role = "solid_stack",
                height_px = card_height,
                source = third,
                card_props = {"label_vertical_align": "center"},
                shell_background = CORNER_DECOR_BG,
                shell_border = "1px solid rgba(98,190,235,0.35)",
            ),
        ],
    )

template metric_triptych_fill_body(
    id = "metric_triptych",
    area = "auto",
    first = metric_source(label = "指标A", value = "0", unit = "项"),
    second = metric_source(label = "指标B", value = "0", unit = "项"),
    third = metric_source(label = "指标C", value = "0", unit = "项"),
    popup_first = None,
    popup_second = None,
    popup_third = None,
    gap = SPACE_MICRO_GAP,
):
    panel(
        id = id,
        area = area,
        variant = "container",
        show_heading = False,
        chrome = "bare",
        props = transparent_panel_props(),
        layout = grid(
            rows = ["1fr"],
            columns = ["1fr", "1fr", "1fr"],
            areas = [["first", "second", "third"]],
            gap = gap,
            align = "stretch",
        ),
        blocks = [
            solid_metric_fill_slot(
                id = id + "_first",
                area = "first",
                source = first,
                popup = popup_first,
            ),
            solid_metric_fill_slot(
                id = id + "_second",
                area = "second",
                source = second,
                popup = popup_second,
            ),
            solid_metric_fill_slot(
                id = id + "_third",
                area = "third",
                source = third,
                popup = popup_third,
            ),
        ],
    )

