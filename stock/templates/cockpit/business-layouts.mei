template metric_matrix_2x3_fill_body(
    id = "metric_matrix_2x3",
    area = "auto",
    first = metric_source(label = "指标1", value = "0", unit = "项"),
    second = metric_source(label = "指标2", value = "0", unit = "项"),
    third = metric_source(label = "指标3", value = "0", unit = "项"),
    fourth = metric_source(label = "指标4", value = "0", unit = "项"),
    fifth = metric_source(label = "指标5", value = "0", unit = "项"),
    sixth = metric_source(label = "指标6", value = "0", unit = "项"),
    gap = SPACE_MICRO_GAP,
):
    panel(
        id = id,
        area = area,
        variant = "container",
        show_heading = False,
        chrome = "bare",
        props = transparent_panel_props(),
        layout = grid(
            rows = ["1fr", "1fr"],
            columns = ["1fr", "1fr", "1fr"],
            areas = [
                ["first", "second", "third"],
                ["fourth", "fifth", "sixth"],
            ],
            gap = gap,
            align = "stretch",
        ),
        blocks = [
            solid_metric_fill_slot(id = id + "_first", area = "first", source = first),
            solid_metric_fill_slot(id = id + "_second", area = "second", source = second),
            solid_metric_fill_slot(id = id + "_third", area = "third", source = third),
            solid_metric_fill_slot(id = id + "_fourth", area = "fourth", source = fourth),
            solid_metric_fill_slot(id = id + "_fifth", area = "fifth", source = fifth),
            solid_metric_fill_slot(id = id + "_sixth", area = "sixth", source = sixth),
        ],
    )

