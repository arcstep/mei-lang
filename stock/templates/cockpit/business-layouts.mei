template metric_quad_body(
    id = "metric_quad",
    area = "auto",
    first = None,
    second = None,
    third = None,
    fourth = None,
    gap = SPACE_MICRO_GAP,
    column_width = "150px",
):
    panel(
        id = id,
        area = area,
        variant = "container",
        show_heading = False,
        chrome = "bare",
        props = transparent_panel_props(),
        layout = grid(
            rows = ["1fr"],
            columns = [column_width, column_width, column_width, column_width],
            areas = [["first", "second", "third", "fourth"]],
            gap = gap,
            align = "stretch",
            justify = "center",
        ),
        blocks = [first, second, third, fourth],
    )

template summary_stack_body(
    id = "summary_stack",
    area = "auto",
    primary = metric_source(label = "总数", value = "0", unit = "次"),
    secondary_a = metric_source(label = "近7日", value = "0", unit = "次"),
    secondary_b = metric_source(label = "子指标", value = "0", unit = "次"),
    gap = SPACE_MICRO_GAP,
):
    panel(
        id = id,
        area = area,
        variant = "container",
        show_heading = False,
        chrome = "bare",
        props = transparent_panel_props(),
        layout = grid(
            rows = ["50px", "32px", "32px"],
            columns = ["1fr"],
            areas = [["primary"], ["secondary_a"], ["secondary_b"]],
            gap = gap,
        ),
        blocks = [
            slot_metric_card(
                id = id + "_primary",
                area = "primary",
                layout_role = "solid_row_accent",
                height_px = 50,
                source = primary,
                shell_background = CORNER_DECOR_BG,
                shell_border = "1px solid rgba(98,190,235,1)",
            ),
            slot_metric_card(
                id = id + "_secondary_a",
                area = "secondary_a",
                layout_role = "solid_row_compact",
                variant = "sub",
                height_px = 32,
                source = secondary_a,
                shell_border = "0.5px solid rgba(115,135,155,1)",
            ),
            slot_metric_card(
                id = id + "_secondary_b",
                area = "secondary_b",
                layout_role = "solid_row_compact",
                variant = "sub",
                height_px = 32,
                source = secondary_b,
                shell_border = "0.5px solid rgba(115,135,155,1)",
            ),
        ],
    )

