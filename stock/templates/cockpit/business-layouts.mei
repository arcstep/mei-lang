template status_triptych_summary_body(
    id = "status_triptych_summary",
    area = "auto",
    pending = metric_source(label = "待办", value = "0", unit = "件"),
    doing = metric_source(label = "在办", value = "0", unit = "件"),
    done = metric_source(label = "已办", value = "0", unit = "件"),
    summary = metric_source(label = "查实率", value = "0", unit = "%"),
    pending_icon = "",
    doing_icon = "",
    done_icon = "",
    summary_icon = "",
    gap = SPACE_MICRO_GAP,
    top_height = 74,
    summary_height = 74,
    summary_padding = "0 16px 0 24px",
):
    panel(
        id = id,
        area = area,
        variant = "container",
        show_heading = False,
        chrome = "bare",
        props = transparent_panel_props(),
        layout = grid(
            rows = ["74px", "74px"],
            columns = ["1fr", "1fr", "1fr"],
            areas = [["pending", "doing", "done"], ["summary", "summary", "summary"]],
            gap = gap,
        ),
        blocks = [
            slot_metric_card(
                id = id + "_pending",
                area = "pending",
                layout_role = "icon_left",
                height_px = top_height,
                shell_height = str(top_height) + "px",
                source = pending,
                presentation = {"icon": pending_icon} if pending_icon != "" else None,
                shell_background = CORNER_DECOR_BG,
            ),
            slot_metric_card(
                id = id + "_doing",
                area = "doing",
                layout_role = "icon_left",
                height_px = top_height,
                shell_height = str(top_height) + "px",
                source = doing,
                presentation = {"icon": doing_icon} if doing_icon != "" else None,
                shell_background = CORNER_DECOR_BG,
            ),
            slot_metric_card(
                id = id + "_done",
                area = "done",
                layout_role = "icon_left",
                height_px = top_height,
                shell_height = str(top_height) + "px",
                source = done,
                presentation = {"icon": done_icon} if done_icon != "" else None,
                shell_background = CORNER_DECOR_BG,
            ),
            slot_metric_card(
                id = id + "_summary",
                area = "summary",
                layout_role = "strip_icon_left",
                height_px = summary_height,
                shell_height = str(summary_height) + "px",
                source = summary,
                presentation = {"icon": summary_icon} if summary_icon != "" else None,
                shell_background = CORNER_DECOR_BG,
                card_props = {"padding": summary_padding},
            ),
        ],
    )

