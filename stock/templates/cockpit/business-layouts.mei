template primary_progress_triptych_body(
    id = "primary_progress_triptych",
    area = "auto",
    primary = None,
    first = None,
    second = None,
    third = None,
    primary_width = "168px",
    gap = SPACE_MICRO_GAP,
):
    panel(
        id = id,
        area = area,
        variant = "container",
        show_heading = False,
        chrome = "bare",
        props = content_fill_props() | transparent_panel_props(),
        layout = grid(
            rows = ["1fr"],
            columns = [primary_width, "1fr"],
            areas = [["primary", "triptych"]],
            gap = gap,
            align = "start",
        ),
        blocks = [
            primary,
            panel(
                id = id + "_triptych",
                area = "triptych",
                variant = "container",
                show_heading = False,
                chrome = "bare",
                props = content_fill_props() | transparent_panel_props(height = "auto"),
                layout = grid(
                    rows = ["1fr"],
                    columns = ["1fr", "1fr", "1fr"],
                    areas = [["first", "second", "third"]],
                    gap = "4px",
                    align = "start",
                ),
                blocks = [first, second, third],
            ),
        ],
    )

template metric_triptych_compound_body(
    id = "metric_triptych_compound",
    area = "auto",
    first = None,
    second = None,
    third = None,
    compound = None,
    first_width = "88px",
    second_width = "88px",
    third_width = "88px",
    compound_width = "220px",
    gap = SPACE_COMPOUND_GAP,
    row_height = "1fr",
    row_align = "start",
    fill_strip = false,
):
    strip_panel_props = transparent_panel_props(height = "100%") if fill_strip else transparent_panel_props(height = "auto")
    strip_row_align = "stretch" if fill_strip else row_align
    panel(
        id = id,
        area = area,
        variant = "container",
        show_heading = False,
        chrome = "bare",
        props = strip_panel_props,
        layout = grid(
            rows = [row_height],
            columns = [first_width, second_width, third_width, compound_width],
            areas = [["first", "second", "third", "compound"]],
            gap = gap,
            align = strip_row_align,
            justify = "center",
        ),
        blocks = [first, second, third, compound],
    )

template compound_metric_slot(
    id,
    area,
    child,
):
    panel(
        id = id,
        area = area,
        variant = "container",
        show_heading = False,
        chrome = "bare",
        props = {
            "padding": "0",
            "background": "transparent",
            "width": "100%",
            "height": "100%",
            "min_height": "0",
            "box_sizing": "border-box",
            "overflow": "hidden",
        },
        layout = grid(
            rows = ["1fr"],
            columns = ["1fr"],
            areas = [["content"]],
            gap = "0",
            align = "stretch",
        ),
        blocks = [child],
    )

template wide_metric_compound_body(
    id = "wide_metric_compound",
    area = "auto",
    width = "220px",
    height = "100%",
    shell_padding = "0",
    main = None,
    sub_a = None,
    sub_b = None,
    sub_c = None,
    top_band_fr = 48,
    bottom_band_fr = 52,
):
    slot_metric_shell(
        id = id,
        area = area,
        padding = shell_padding,
        background = compound_slot_background(image = BG_TARGET),
        width = width,
        height = height,
        shell_props = SLOT_FRAME_BG_FLAG,
        child = panel(
            template = metric.wide_compound_skin(
                width = "100%",
                top_band_ratio = str(top_band_fr) + "%",
                gap = SPACE_COMPOUND_GAP,
            ),
            id = id + "_body",
            area = "content",
            variant = "container",
            show_heading = False,
            chrome = "bare",
            props = {
                "width": "100%",
                "height": "100%",
                "min_height": "0",
                "background": "transparent",
                "box_shadow": "none",
                "box_sizing": "border-box",
                "overflow": "hidden",
            },
            blocks = [
                compound_metric_slot(id = id + "_top", area = "top", child = main),
                compound_metric_slot(id = id + "_b0", area = "b0", child = sub_a),
                compound_metric_slot(id = id + "_b1", area = "b1", child = sub_b),
                compound_metric_slot(id = id + "_b2", area = "b2", child = sub_c),
            ],
        ),
    )

template long_metric_compound_body(
    id = "long_metric_compound",
    area = "auto",
    width = "100%",
    main = None,
    top = None,
    bottom = None,
):
    panel(
        template = metric.long_compound(width = width, gap = SPACE_COMPOUND_GAP),
        id = id,
        area = area,
        blocks = [main, top, bottom],
    )

template story_opinion_block(
    area = "auto",
    point_id = "",
    title = "说明板",
    body = "<p>这里是一段说明。</p>",
    action_text = "",
    action_link = None,
    emphasis = False,
):
    component(
        "cockpit.opinion-panel",
        area = area,
        props = {
            "point_id": point_id,
            "title": title,
            "body_format": "html",
            "body": body,
            "action_text": action_text,
            "action_link": action_link,
            "emphasis": emphasis,
        },
    )

template story_evidence_frame(
    frame_id = "story_evidence_frame",
    title_text = "业务语义布局示例",
    story = None,
    evidence = None,
    gap = SPACE_STORY_GAP,
    story_width = "1.1fr",
    evidence_width = "0.9fr",
):
    frame_export(
        id = frame_id,
        layout = grid(
            columns = ["1fr"],
            rows = ["1fr", "1fr"],
            areas = [["title"], ["content"]],
            gap = gap,
            padding = "24px",
        ),
        panels = [
            panel(
                id = "title",
                area = "title",
                blocks = [
                    component(
                        "mei.text",
                        area = "auto",
                        props = {
                            "content": title_text,
                            "font_size": "24px",
                            "color": "#e8f0ff",
                        },
                    ),
                ],
            ),
            panel(
                id = "content",
                area = "content",
                variant = "container",
                show_heading = False,
                chrome = "bare",
                props = transparent_panel_props(),
                layout = grid(
                    rows = ["1fr"],
                    columns = [story_width, evidence_width],
                    areas = [["story", "evidence"]],
                    gap = gap,
                ),
                blocks = [
                    panel(
                        id = "story",
                        area = "story",
                        variant = "container",
                        show_heading = False,
                        chrome = "bare",
                        props = transparent_panel_props(),
                        blocks = [story],
                    ),
                    panel(
                        id = "evidence",
                        area = "evidence",
                        variant = "container",
                        show_heading = False,
                        chrome = "bare",
                        props = transparent_panel_props(),
                        blocks = [evidence],
                    ),
                ],
            ),
        ],
    )

