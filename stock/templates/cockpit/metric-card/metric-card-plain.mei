# 无色无图指标卡：用于宽卡/长卡 compound 内层，背景由外层 compound 壳提供。

scene(id = "metric_card_plain_tpl", profile = "cockpit", theme = "cockpit")

world(resources = [])

frame()

frame.add_panel(
    id = "card_plain",
    area = "auto",
    show_heading = False,
    chrome = "bare",
    variant = "container",
    props = {
        "chrome": "bare",
        "padding": "0",
        "width": "100%",
        "height": "100%",
        "box_sizing": "border-box",
        "overflow": "hidden",
        "background": "transparent",
        "__mei_metric_card": True,
        "__mei_metric_density": "normal",
        "__mei_metric_template": "stack",
        "__mei_metric_inline_align": "compact",
    },
    layout = layout_metric_stack(),
    blocks = [
        label("·", area = "label", vertical_align = "end"),
        value("--", area = "value", vertical_align = "center"),
        unit("", area = "unit", vertical_align = "center"),
    ],
)
