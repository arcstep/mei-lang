# 左图标 + 右 stack 文案（152×74）：青蓝底 + background 层 48×48 定位切图；单 panel，勿嵌套。
# 克隆：source= 改文案；props.background.image 换左图（与模板 size/position 深合并）。勿用 bg=（会改成 100% 铺满）。

scene(id = "metric_card_icon_left_tpl", profile = "cockpit", theme = "cockpit")

world(resources = [])

ASSETS = "/workspace-app-assets/templates/cockpit/assets/metrics"
ICON = ASSETS + "/待办@3x.png"

frame(
    panels = [
panel(
    id = "card_icon_left",
    area = "auto",
    show_heading = False,
    chrome = "bare",
    variant = "container",
    props = {
        "chrome": "bare",
        "width": "152px",
        "height": "74px",
        "padding": "10px 8px 10px 70px",
        "box_sizing": "border-box",
        "overflow": "hidden",
        "__mei_metric_card": True,
        "__mei_metric_density": "compact",
        "__mei_metric_template": "stack",
        "__mei_metric_title_ratio": "2",
        "__mei_metric_content_ratio": "3",
        "background": {
            "color": "rgba(98,190,235,0.10)",
            "image": "url(" + ICON + ")",
            "size": "48px 48px",
            "position": "11px center",
            "repeat": "no-repeat",
        },
    },
    layout = layout_metric_stack(title_ratio = 2, content_ratio = 3),
    blocks = [
        label("待办", area = "label", vertical_align = "start"),
        value("22", area = "value", vertical_align = "end"),
        unit("件", area = "unit", vertical_align = "end"),
    ],
),
    ],
)


