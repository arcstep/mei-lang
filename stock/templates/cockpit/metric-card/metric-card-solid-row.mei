# 横排纯色指标卡：card_solid_row_accent（132×50 宽松强调）/ card_solid_row_compact（132×32 紧凑细框）。

scene(id = "metric_card_solid_row_tpl", profile = "cockpit", theme = "cockpit")

world(resources = [])

frame(
    panels = [
panel(
    id = "card_solid_row_accent",
    area = "auto",
    show_heading = False,
    chrome = "bare",
    variant = "container",
    props = {
        "chrome": "bare",
        "padding": "2px 8px",
        "width": "132px",
        "height": "50px",
        "box_sizing": "border-box",
        "overflow": "hidden",
        "__mei_metric_card": True,
        "__mei_metric_density": "compact",
        "__mei_metric_template": "row",
        "__mei_metric_inline_align": "compact",
        "background": {"color": "rgba(98,190,235,0.10)"},
        "border": "1px solid rgba(98,190,235,1)",
        "box_shadow": "inset 0px 0px 50px 0px rgba(45,128,255,0.9)",
    },
    layout = grid(
        rows = ["1fr"],
        columns = ["auto", "auto", "auto"],
        areas = [["label", "value", "unit"]],
        gap = "4px",
        align = "center",
        justify = "start",
    ),
    blocks = [
        label("总数", area = "label", align = "left", vertical_align = "center"),
        value("200", area = "value", align = "left", vertical_align = "center"),
        unit("次", area = "unit", align = "left", vertical_align = "center"),
    ],
),
panel(
    id = "card_solid_row_compact",
    area = "auto",
    show_heading = False,
    chrome = "bare",
    variant = "container",
    props = {
        "chrome": "bare",
        "padding": "0 8px",
        "width": "132px",
        "height": "32px",
        "box_sizing": "border-box",
        "overflow": "hidden",
        "background": "transparent",
        "border": "0.5px solid rgba(115,135,155,1)",
        "__mei_metric_card": True,
        "__mei_metric_density": "compact",
        "__mei_metric_template": "row",
        "__mei_metric_inline_align": "compact",
    },
    layout = grid(
        rows = ["1fr"],
        columns = ["auto", "auto", "auto"],
        areas = [["label", "value", "unit"]],
        gap = "4px",
        align = "center",
        justify = "start",
    ),
    blocks = [
        label("近7日", area = "label", align = "left", vertical_align = "center"),
        value("20", area = "value", align = "left", vertical_align = "center"),
        unit("次", area = "unit", align = "left", vertical_align = "center"),
    ],
),
    ],
)


