# 叠排纯色指标卡（152×54 stack）：card_solid_stack_plain（纯底+描边）/ card_solid_stack_corner（四角 #71F1EA 装饰）。

scene(id = "metric_card_solid_stack_tpl", profile = "cockpit", theme = "cockpit")

world(resources = [])

CORNER_DECOR_BG = (
    "linear-gradient(#71F1EA,#71F1EA) left top / 4px 2px no-repeat,"
    + "linear-gradient(#71F1EA,#71F1EA) right top / 4px 2px no-repeat,"
    + "linear-gradient(#71F1EA,#71F1EA) left bottom / 4px 2px no-repeat,"
    + "linear-gradient(#71F1EA,#71F1EA) right bottom / 4px 2px no-repeat,"
    + "rgba(98,190,235,0.10)"
)

SOLID_STACK_SHELL = {
    "chrome": "bare",
    "padding": "4px 8px",
    "width": "152px",
    "height": "54px",
    "box_sizing": "border-box",
    "overflow": "hidden",
    "__mei_metric_card": True,
    "__mei_metric_density": "compact",
    "__mei_metric_template": "stack",
    "__mei_metric_inline_align": "compact",
    "__mei_metric_title_ratio": "2",
    "__mei_metric_content_ratio": "3",
    "border": "1px solid rgba(98,190,235,0.35)",
}

frame()

frame.add_panel(
    id = "card_solid_stack_plain",
    area = "auto",
    show_heading = False,
    chrome = "bare",
    variant = "container",
    props = SOLID_STACK_SHELL | {
        "background": {"color": "rgba(98,190,235,0.10)"},
    },
    layout = layout_metric_stack(title_ratio = 2, content_ratio = 3),
    blocks = [
        label("总数", area = "label", vertical_align = "center"),
        value("200", area = "value", vertical_align = "center"),
        unit("次", area = "unit", vertical_align = "center"),
    ],
)

frame.add_panel(
    id = "card_solid_stack_corner",
    area = "auto",
    show_heading = False,
    chrome = "bare",
    variant = "container",
    props = SOLID_STACK_SHELL | {
        "background": CORNER_DECOR_BG,
    },
    layout = layout_metric_stack(title_ratio = 2, content_ratio = 3),
    blocks = [
        label("总数", area = "label", vertical_align = "center"),
        value("200", area = "value", vertical_align = "center"),
        unit("次", area = "unit", vertical_align = "center"),
    ],
)
