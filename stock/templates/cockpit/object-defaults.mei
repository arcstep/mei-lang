# Internal expansion seeds and pre-recipe compatibility macros.
#
# New authoring must use object(... recipe = stock_ref(...), slots = {...}).
# The compiler owns recipe expansion; authors must not call
# object_binding_props/object_viewpoint or the action helpers directly.
#
# These definitions remain temporarily for older generated sources. They only
# expand to existing Mei calls and dictionaries and never infer identity or
# copy owner payloads.

use template "cockpit/layout-defaults" as layout_defaults

template object_binding_props(
    object_type,
    identity_field,
    object_id = "",
    entity_id = "",
):
    {
        "objectType": object_type,
        "objectId": object_id,
        "identityField": identity_field,
        "entityId": entity_id,
    }

template object_viewpoint(
    id = "",
    label = "",
    object_id = "",
    entity_id = "",
    world_ref = "",
    view_family = "",
    camera_preset = "",
    group_id = "",
):
    viewpoint(
        id = id,
        label = label,
        objectId = object_id,
        entityId = entity_id,
        worldRef = world_ref,
        viewFamily = view_family,
        cameraPreset = camera_preset,
        groupId = group_id,
    )

template object_metric_card(
    id = "metric_card",
    area = None,
    source = {"label": "指标", "value": "--", "unit": ""},
    metric = None,
    popup = None,
    viewpoint_id = "",
    viewpoint_label = "",
    object_id = "",
    entity_id = "",
    world_ref = "",
    view_family = "",
    camera_preset = "",
    group_id = "",
    layout = None,
    placements = None,
):
    layout_defaults.narrow_metric_card(
        id = id,
        area = area,
        source = source,
        metric = metric,
        popup = popup,
        viewpoint = object_viewpoint(
            id = viewpoint_id,
            label = viewpoint_label,
            object_id = object_id,
            entity_id = entity_id,
            world_ref = world_ref,
            view_family = view_family,
            camera_preset = camera_preset,
            group_id = group_id,
        ),
        layout = layout,
        placements = placements,
    )

template object_world_entry_action(
    object_id = "",
    entity_id = "",
    viewpoint = "",
    world_ref = "",
    camera_preset = "",
    group_id = "",
):
    {
        "type": "enter_world_view",
        "objectId": object_id,
        "entityId": entity_id,
        "viewpoint": viewpoint,
        "worldRef": world_ref,
        "cameraPreset": camera_preset,
        "groupId": group_id,
    }

template object_t2_action(
    object_id = "",
    page_panel_id = "",
    page_scene_id = "",
):
    {
        "type": "open_t2_page",
        "objectId": object_id,
        "pagePanelId": page_panel_id,
        "pageSceneId": page_scene_id,
    }

template object_narration_target(
    object_id = "",
    viewpoint = "",
):
    {
        "objectId": object_id,
        "viewpoint": viewpoint,
    }
