    viewpoint = None,
):
    metric_card(
        id = id,
        area = area,
        source = source,
        metric = metric,
        popup = popup,
        viewpoint = viewpoint,
        surface = "stack_desc",
        desc = desc,
        props = {
            "width": "100%",
            "height": "100%",
            "min_height": "0",
            "box_sizing": "border-box",
            "background": {
                "image": "url(" + METRICS_ASSET + "/metric-bg-mid@3x.svg)",
                "size": "100% 100%",
                "position": "center",
                "repeat": "no-repeat",
                "origin": "border-box",
                "clip": "border-box",
            },
            "padding": LAYOUT_SPACE_1,
            "radius": "0",
            "border": "none",
            "__mei_slot_frame_bg": True,
            "__mei_layout_fill": True,
        },
    )

# --- 左侧图标状态卡（icon_left；充满父格）---
template icon_metric_card(
    id = "metric_card",
    area = None,
    source = {"label": "指标", "value": "--", "unit": ""},
    metric = None,
    popup = None,
    icon_css = "",
    icon_position = "11px center",
    surface = "icon_left",
    padding = "10px 8px 10px 70px",
):
    metric_card(
        id = id,
        area = area,
        source = source,
        metric = metric,
        popup = popup,
        surface = surface,
        props = {
            "width": "100%",
            "height": "100%",
            "min_height": "0",
            "box_sizing": "border-box",
            "padding": padding,
            "background": {
                "color": "rgba(98,190,235,0.10)",
                "image": icon_css,
                "size": "48px 48px",
                "position": icon_position,
                "repeat": "no-repeat",
            },
            "radius": "0",
            "border": "none",
            "__mei_layout_fill": True,
        },
    )

# --- 行式 accent / compact 指标（行政检查/处罚左侧列；横排 label|value|unit，纯色底）---
template row_accent_metric_card(
    id = "metric_card",
    area = None,
    source = {"label": "指标", "value": "--", "unit": ""},
    metric = None,
    popup = None,
):
    row_solid_metric_card(
        id = id,
        area = area,
        source = source,
        metric = metric,
        popup = popup,
        surface = "solid_row_accent",
        border = "1px solid rgba(98,190,235,1)",
    )

template row_accent_sub_metric_card(
    id = "metric_card",
    area = None,
    source = {"label": "指标", "value": "--", "unit": ""},
    metric = None,
    popup = None,
):
    row_solid_metric_card(
        id = id,
        area = area,
        source = source,
        metric = metric,
        popup = popup,
        surface = "solid_row_compact",
        border = "0.5px solid rgba(115,135,155,1)",
        variant = "sub",
    )

template row_solid_metric_card(
    id = "metric_card",
    area = None,
    source = {"label": "指标", "value": "--", "unit": ""},
    metric = None,
    popup = None,
    surface = "solid_row_accent",
    border = "1px solid rgba(98,190,235,1)",
    variant = None,
):
    metric_card(
        id = id,
        area = area,
        source = source,
        metric = metric,
        popup = popup,
        surface = surface,
        variant = variant,
        layout = grid(
            rows = ["1fr"],
            columns = ["auto", "auto", "auto"],
            areas = [["label", "value", "unit"]],
            gap = LAYOUT_SPACE_1,
            align = "center",
            justify = "start",
        ),
        props = {
            "width": "100%",
            "height": "100%",
            "min_height": "0",
            "box_sizing": "border-box",
            "background": {
                "color": "rgba(98,190,235,0.10)",
                "size": "100% 100%",
                "origin": "border-box",
                "clip": "border-box",
            },
            "padding": "0 4px",
            "radius": "0",
            "border": border,
            "__mei_layout_fill": True,
            "label_vertical_align": "center",
            "value_vertical_align": "center",
            "unit_vertical_align": "center",
        },
    )

# --- 进度说明卡（stack_progress；desc 槽走进度条）---
# 显式 background 会跳过 surface chrome 合并，故 progress 相关 props 必须手写齐全。
PROGRESS_SHELL = {
    "inset_x": "0px",
    "extend_x": "10px",
    "height": "10px",
    "border_radius": "0",
    "fill": "#C9E9F8",
}

# zhifa PROGRESS_STACK_ROWS：固定六行，避免 desc 进度条与右侧 donut 重叠
PROGRESS_STACK_ROWS = ["12px", "20px", "34px", "10px", "18px", "10px"]

template progress_metric_card(
    id = "metric_card",
    area = None,
    source = {"label": "指标", "value": "--", "unit": ""},
    metric = None,
    desc = "",
    popup = None,
    variant = None,
    height_px = None,
):
    metric_card(
        id = id,
        area = area,
        source = source,
        metric = metric,
        popup = popup,
        surface = "stack_progress",
        desc = desc,
        variant = variant,
        height_px = height_px,
        layout = grid(
            rows = PROGRESS_STACK_ROWS,
            columns = ["auto", "auto"],
            areas = [
                [".", "."],
                ["label", "label"],
                ["value", "unit"],
                [".", "."],
                ["desc", "desc"],
                [".", "."],
            ],
            gap = "0",
            align = "stretch",
            justify = "center",
        ),
        props = {
            "width": "100%",
            "height": "100%",
            "min_height": "0",
            "max_height": "100%",
            "box_sizing": "border-box",
            "overflow": "hidden",
            "background": {
                "color": "transparent",
                "image": "url(" + METRICS_ASSET + "/metric-bg-clean@3x.svg)",
                "size": "100% 100%",
                "position": "center",
                "repeat": "no-repeat",
                "origin": "border-box",
                "clip": "border-box",
            },
            "padding": "0",
            "radius": "0",
            "border": "none",
            "__mei_slot_frame_bg": True,
            "__mei_slot_bg_stretch": True,
            "__mei_layout_fill": True,
            "__mei_metric_template": "stack_desc",
            "__mei_metric_density": "compact",
            "__mei_metric_inline_align": "compact",
            "__mei_metric_desc_mode": "progress",
            "metric_desc_mode": "progress",
            "metric_desc_shell": PROGRESS_SHELL,
            "__mei_metric_label_v_align": "center",
            "__mei_metric_value_v_align": "end",
            "__mei_metric_unit_v_align": "end",
        },
    )
