# Layout constructor defaults（0332 / 金样）
# 每种外观一个完整宏：调用点只传 id / 数据 / 可选 layout·blocks。
# 不要再「通用 metric_card + chrome_* props」叠两层。
# 用法：use template "cockpit/layout-defaults" as ui
#
# 层级边距：**省略即默认**（semantic_scene / section_shell lower 注入）。
# 下列宏仅供显式覆盖或文档对照；金样不要再到处抄写默认值。

METRICS_ASSET = "/workspace-app-assets/templates/cockpit/assets/metrics"

# zhifa card_solid_stack_corner：四角 #71F1EA L 形装饰 + 半透明底
CORNER_DECOR_BG = "linear-gradient(#71F1EA,#71F1EA) left top / 4px 2px no-repeat,"
    + "linear-gradient(#71F1EA,#71F1EA) right top / 4px 2px no-repeat,"
    + "linear-gradient(#71F1EA,#71F1EA) left bottom / 4px 2px no-repeat,"
    + "linear-gradient(#71F1EA,#71F1EA) right bottom / 4px 2px no-repeat,"
    + "rgba(98,190,235,0.10)"
SOLID_PLAIN_BG = {"color": "rgba(98,190,235,0.10)"}

# --- 层级边距规范（0332）：字面 1px ---
# plane  gap→region 外边距 1px / padding 1px
# region gap→section 外边距 1px / padding 1px / border 0 / radius 0
# section gap→内网格外边距 1px / padding 1px / border 1px / radius 0
# content（section 内网格）padding 0 / border 0 / align+justify stretch
# 省略时由平台注入；显式 gap/padding（含 "0"）覆盖。
LAYOUT_SPACE_1 = "1px"
SECTION_MARGIN = "1px"
REGION_MARGIN = "1px"

template layout_space_1():
    LAYOUT_SPACE_1

# plane 内边距—— 省略时注入，宏仅覆盖用
template plane_padding():
    LAYOUT_SPACE_1

# region 外边距 → 落在父 plane 的 grid.gap
template region_margin():
    REGION_MARGIN

# region 内边距
template region_padding():
    LAYOUT_SPACE_1

# section 外边距 → 落在父 region 的 grid.gap
template section_margin():
    SECTION_MARGIN

# section 内边距
template section_padding():
    LAYOUT_SPACE_1

# section 内网格：外边距 → section grid.gap；内边距 → 0
template area_margin():
    LAYOUT_SPACE_1

template area_padding():
    "0"

# T2 page_instance frame（analytics_frame 等）：与 scene 树同单位 1px。
template frame_padding():
    LAYOUT_SPACE_1

template frame_gap():
    LAYOUT_SPACE_1

template bg_panel_glow():
    "linear-gradient(180deg, rgba(32, 96, 168, 0.72) 0%, rgba(14, 48, 92, 0.88) 100%)"

# --- 窄指标卡（显式 SVG 底；充满父 grid 格）---
template narrow_metric_card(
    id = "metric_card",
    area = None,
    source = {"label": "指标", "value": "--", "unit": ""},
    metric = None,
    popup = None,
    viewpoint = None,
    layout = None,
    placements = None,
):
    metric_card(
        id = id,
        area = area,
        source = source,
        metric = metric,
        popup = popup,
        viewpoint = viewpoint,
        layout = layout,
        placements = placements,
        props = {
            "width": "100%",
            "height": "100%",
            "min_height": "0",
            "box_sizing": "border-box",
            "background": {
                "image": "url(" + METRICS_ASSET + "/metric-bg-normal@3x.svg)",
                "size": "100% 100%",
                "position": "center",
                "repeat": "no-repeat",
                "origin": "border-box",
                "clip": "border-box",
            },
            "padding": LAYOUT_SPACE_1,
            "radius": "0",
            "border": "none",
            "__mei_slot_frame_bg": True,
            "__mei_layout_fill": True,
        },
    )

# --- 四角点缀 stack 指标卡（监督预警三联；对齐 zhifa card_solid_stack_corner）---
# 注意：勿开 __mei_slot_frame_bg，否则会把四角 4px 装饰拉伸成 100%。
template corner_metric_card(
    id = "metric_card",
    area = None,
    source = {"label": "指标", "value": "--", "unit": ""},
    metric = None,
    popup = None,
):
    metric_card(
        id = id,
        area = area,
        source = source,
        metric = metric,
        popup = popup,
        surface = "solid_stack",
        props = {
            "width": "100%",
            "height": "100%",
            "min_height": "0",
            "box_sizing": "border-box",
            "background": CORNER_DECOR_BG,
            "border": "1px solid rgba(98,190,235,0.35)",
            "padding": "4px 8px",
            "radius": "0",
            "__mei_layout_fill": True,
            "label_vertical_align": "center",
        },
    )

# --- 纯色 stack 指标卡（监督成效 2×3，无四角装饰）---
template plain_solid_metric_card(
    id = "metric_card",
    area = None,
    source = {"label": "指标", "value": "--", "unit": ""},
    metric = None,
    popup = None,
):
    metric_card(
        id = id,
        area = area,
        source = source,
        metric = metric,
        popup = popup,
        surface = "solid_stack",
        props = {
            "width": "100%",
            "height": "100%",
            "min_height": "0",
            "box_sizing": "border-box",
            "background": SOLID_PLAIN_BG,
            "border": "1px solid rgba(98,190,235,0.35)",
            "padding": "4px 8px",
            "radius": "0",
            "__mei_layout_fill": True,
            "label_vertical_align": "center",
        },
    )

# --- 行内指标卡（label|value|unit 水平；嵌在 compound 顶行，不自带底）---
template row_metric_card(
    id = "metric_card",
    area = None,
    source = {"label": "指标", "value": "--", "unit": ""},
    metric = None,
    popup = None,
    placements = None,
):
    metric_card(
        id = id,
        area = area,
        source = source,
        metric = metric,
        popup = popup,
        placements = placements,
        surface = "compound_top_row",
        layout = grid(
            rows = ["1fr"],
            columns = ["auto", "auto", "auto"],
            areas = [["label", "value", "unit"]],
            gap = LAYOUT_SPACE_1,
            align = "center",
            justify = "start",
        ),
        props = {
            "width": "100%",
            "height": "100%",
            "min_height": "0",
            "box_sizing": "border-box",
            "padding": LAYOUT_SPACE_1,
            "border": "none",
            "__mei_layout_fill": True,
        },
    )

# --- 透明子卡（嵌在 compound 内，无独立底；字段 stack + 格内居中）---
template plain_metric_card(
    id = "metric_card",
    area = None,
    source = {"label": "指标", "value": "--", "unit": ""},
    metric = None,
    popup = None,
    layout = None,
    placements = None,
):
    metric_card(
        id = id,
        area = area,
        source = source,
        metric = metric,
        popup = popup,
        layout = layout,
        placements = placements,
        surface = "compound_sub_stack",
        props = {
            "width": "100%",
            "height": "100%",
            "min_height": "0",
            "box_sizing": "border-box",
            "padding": "0",
            "border": "none",
            "__mei_layout_fill": True,
        },
    )

# --- 复合框 panel（显式 target SVG 底；充满父 grid 格）---
template compound_panel(
    id = "panel",
    area = None,
    layout = None,
    blocks = [],
    padding = LAYOUT_SPACE_1,
):
    panel(
        id = id,
        area = area,
        variant = "container",
        chrome = "bare",
        show_heading = False,
        props = {
            "width": "100%",
            "height": "100%",
            "min_height": "0",
            "box_sizing": "border-box",
            "background": {
                "image": "url(" + METRICS_ASSET + "/metric-bg-target@3x.svg)",
                "size": "100% 100%",
                "position": "center",
                "repeat": "no-repeat",
                "origin": "border-box",
                "clip": "border-box",
            },
            "padding": padding,
            "radius": "0",
            "border": "none",
            "__mei_slot_frame_bg": True,
            "__mei_layout_fill": True,
        },
        layout = layout,
        blocks = blocks,
    )

# --- 带目标说明的指标卡（stack_desc；充满父格）---
