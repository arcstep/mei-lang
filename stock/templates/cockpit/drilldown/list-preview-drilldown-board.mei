# 清单预览型二级看板壳：左过滤 + 中明细清单 + 右条目预览；布局由宿主 overlay 消费 projection_slots.layout_zone。

scene(
    id = "list_preview_drilldown_board",
    profile = "cockpit",
    theme = "cockpit",
    summary = "清单预览型二级看板：左过滤 + 中明细清单 + 右条目预览",
    params = {
        "metric": param(type = "metric", required = True),
        "rowset_dataset_id": param(type = "string"),
        "entry": param(type = "string"),
    },
    local_nav = {
        "kind": "list_preview_drilldown_board",
        "scene_id": "list_preview_drilldown_board",
        "overlay_size": "large",
    },
)

world(resources = [])

frame(
    layout = grid(
        columns = ["minmax(180px, 1fr)", "minmax(0, 2.2fr)", "minmax(220px, 1.1fr)"],
        rows = ["minmax(0, 1fr)"],
        areas = [["filter", "list", "preview"]],
        gap = "12px",
        padding = "12px",
    ),
)

frame.add_panel(
    id = "filter",
    area = "filter",
    slot = panel_slot(kind = "filter", source = "filter_schema"),
    blocks = [],
)

frame.add_panel(
    id = "list",
    area = "list",
    slot = panel_slot(kind = "slots", accepts = ["data_table"], required = True),
    blocks = [],
)

frame.add_panel(
    id = "preview",
    area = "preview",
    slot = panel_slot(kind = "row_preview", accepts = ["summary"], selection_from = "list"),
    blocks = [],
)
