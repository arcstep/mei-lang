# 通用二级看板壳：Tab 列表由 link.projection_slots 驱动，本 scene 不声明固定 explain tabs。

scene(
    id = "generic_drilldown_board",
    profile = "cockpit",
    theme = "cockpit",
    summary = "通用指标下钻：动态 projection_slots",
    params = {
        "metric": param(type = "metric", required = True),
        "rowset_dataset_id": param(type = "string"),
        "entry": param(type = "string"),
    },
    local_nav = {
        "scene_id": "generic_drilldown_board",
        "include_hero": True,
    },
)

world(resources = [])

frame(
    layout = grid(
        columns = ["1fr"],
        rows = ["auto", "minmax(0, 1fr)"],
        areas = [["tabs"], ["content"]],
        gap = "12px",
        padding = "12px",
    ),
)

frame.add_panel(
    id = "tabs",
    area = "tabs",
    slot = panel_slot(kind = "tab_bar"),
    blocks = [],
)

frame.add_panel(
    id = "content",
    area = "content",
    slot = panel_slot(kind = "tab_content"),
    blocks = [],
)
