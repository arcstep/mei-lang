# Proof: chart.pie / chart.donut / chart.rose composition mapping.

app(
    id = "author-example-chart-composition",
    title = "Author Example Chart Composition",
    default_scene = "home",
)

scene(
    id = "home",
    world = "home_world",
    frame = "home_frame",
    profile = "chart",
    summary = "Composition charts for donut/pie/rose preview.",
)

world(
    id = "home_world",
    resources = [
        resource(
            id = "chart_data",
            kind = "dataset",
            title = "Chart sample",
            source = ds.csv(path = "../../stock/authoring/examples/data/chart-lab.csv"),
        ),
    ],
)

frame(
    id = "home_frame",
    layout = flex(direction = "column", gap = "16px", padding = "20px"),
)

frame.add_panel(
    id = "donut_panel",
    area = "auto",
    blocks = [
        component(
            "chart.donut",
            area = "auto",
            props = {
                "title": "Revenue donut",
                "data": dataset_ref(id = "chart_data"),
                "mapping": {
                    "label": [{"field": "label", "name": "Series"}],
                    "y": [{"field": "revenue", "name": "Revenue"}],
                },
            },
        ),
    ],
)

frame.add_panel(
    id = "pie_panel",
    area = "auto",
    blocks = [
        component(
            "chart.pie",
            area = "auto",
            props = {
                "title": "Revenue composition",
                "data": dataset_ref(id = "chart_data"),
                "mapping": {
                    "label": [{"field": "label", "name": "Series"}],
                    "y": [{"field": "revenue", "name": "Revenue"}],
                },
            },
        ),
    ],
)

frame.add_panel(
    id = "rose_panel",
    area = "auto",
    blocks = [
        component(
            "chart.rose",
            area = "auto",
            props = {
                "title": "Revenue rose",
                "data": dataset_ref(id = "chart_data"),
                "mapping": {
                    "label": [{"field": "label", "name": "Series"}],
                    "y": [{"field": "revenue", "name": "Revenue"}],
                },
            },
        ),
    ],
)
