# Proof: chart.radar / chart.scatter multi-channel mapping.

app(
    id = "author-example-chart-radar",
    title = "Author Example Chart Radar",
    default_scene = "home",
)

scene(
    id = "home",
    world = "home_world",
    frame = "home_frame",
    profile = "chart",
    summary = "Radar and scatter chart preview examples.",
)

world(
    id = "home_world",
    resources = [
        resource(
            id = "chart_data",
            kind = "dataset",
            title = "Chart sample",
            source = ds.csv(path = "../../stock/authoring/examples/data/chart-lab.csv"),
        ),
    ],
)

frame(
    id = "home_frame",
    layout = flex(direction = "column", gap = "16px", padding = "20px"),
)

frame.add_panel(
    id = "radar_panel",
    area = "auto",
    blocks = [
        component(
            "chart.radar",
            area = "auto",
            props = {
                "title": "Multi metric radar",
                "data": dataset_ref(id = "chart_data"),
                "mapping": {
                    "label": [{"field": "label", "name": "Series"}],
                    "y": [
                        {"field": "revenue", "name": "Revenue"},
                        {"field": "orders", "name": "Orders"},
                    ],
                },
            },
        ),
    ],
)

frame.add_panel(
    id = "scatter_panel",
    area = "auto",
    blocks = [
        component(
            "chart.scatter",
            area = "auto",
            props = {
                "title": "Revenue vs orders",
                "data": dataset_ref(id = "chart_data"),
                "mapping": {
                    "x": [{"field": "revenue", "name": "Revenue"}],
                    "y": [{"field": "orders", "name": "Orders"}],
                    "label": [{"field": "label", "name": "Series"}],
                },
            },
        ),
    ],
)
