use template "cockpit/layout-defaults" as ui

section_layout(
    id = "metric",
    key = "fx-structure/home/t1/region-main/section-metric",
    area = "metric",
    title = "Structure metric",
    budget = budget(width = "100%", padding = "8px 6px 6px 6px"),
    layout = grid(
        rows = ["auto", "minmax(0, 1fr)"],
        columns = ["1fr"],
        areas = [["title"], ["body"]],
    ),
    shell = section_shell(
        title = "Structure metric",
        width = "100%",
        padding = "8px 6px 6px 6px",
        body = content_panel(
            id = "fx-metric",
            variant = "container",
            chrome = "bare",
            props = {
                "__mei_layout_fill": True,
            },
            layout = grid(
                rows = ["1fr"],
                columns = ["1fr"],
                areas = [["demo_metric"]],
                gap = "0",
            ),
            blocks = [
                ui.narrow_metric_card(
                    id = "demo_metric",
                    source = {"label": "Fixture", "value": "3", "unit": "rows"},
                    popup = link_ref("fx-structure/home/t1/region-main/section-metric/links/fx-analytics"),
                ),
            ],
        ),
    ),
)
