                    "column": "预警模型",
                },
                {
                    "key": "warningLevel",
                    "label": "预警等级",
                    "column": "预警等级",
                },
            ],
        },
        "projection_slots": [
            {
                "id": "main",
                "layout_zone": "main",
                "kind": "placeholder",
            },
        ],
    },
    examples = [
