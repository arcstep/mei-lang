    tier = "t2",
    budget = budget(width = "100%"),
    layout = grid(
        rows = ["1fr"],
        columns = ["1fr"],
        areas = [["main"]],
        gap = "0",
    ),
    regions = [],
)

page_instance(
    key = "fx-diag-default-filters/home/t1/region-main/section-metric/plane-target",
    scene = "fx_target_page",
    profile = "cockpit",
    theme = theme_ref("cockpit"),
