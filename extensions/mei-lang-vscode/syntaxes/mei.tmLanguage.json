{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MeiLang",
  "scopeName": "source.mei",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string-triple-double" },
    { "include": "#string-triple-single" },
    { "include": "#string-double" },
    { "include": "#string-single" },
    { "include": "#number" },
    { "include": "#declaration-call" },
    { "include": "#keywords" },
    { "include": "#literals" },
    { "include": "#operator" },
    { "include": "#punctuation" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.mei",
      "match": "#.*$"
    },
    "string-triple-double": {
      "name": "string.quoted.triple.double.mei",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        { "name": "constant.character.escape.mei", "match": "\\\\." }
      ]
    },
    "string-triple-single": {
      "name": "string.quoted.triple.single.mei",
      "begin": "'''",
      "end": "'''",
      "patterns": [
        { "name": "constant.character.escape.mei", "match": "\\\\." }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.mei",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.mei", "match": "\\\\." }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.mei",
      "begin": "'",
      "end": "'",
      "patterns": [
        { "name": "constant.character.escape.mei", "match": "\\\\." }
      ]
    },
    "number": {
      "name": "constant.numeric.mei",
      "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?\\b"
    },
    "declaration-call": {
      "name": "meta.declaration.mei",
      "match": "\\b(app_skeleton|navigation|page_instance|content_panel|metric_def_bundle|link_decl|warmup_policy|app|entry|scene|world|flow|frame|panel|component|resource|entity|topology|theme|layout|intent|start|click|timer|tick|rule|cell|subject|outcome)\\s*(?=\\()",
      "captures": {
        "1": { "name": "keyword.control.declaration.mei" }
      }
    },
    "keywords": {
      "name": "keyword.control.mei",
      "match": "\\b(and|or|not|in)\\b"
    },
    "literals": {
      "name": "constant.language.mei",
      "match": "\\b(True|False|None|true|false)\\b"
    },
    "operator": {
      "name": "keyword.operator.mei",
      "match": "==|!=|<=|>=|//|\\*\\*|=|\\+|\\-|\\*|/|%|<|>|!"
    },
    "punctuation": {
      "name": "punctuation.mei",
      "match": "[\\(\\)\\[\\]\\{\\},\\.:]"
    },
    "identifier": {
      "name": "variable.other.mei",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
