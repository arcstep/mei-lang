{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arcstep/mei-lang/schemas/admin-manifest-v1.json",
  "title": "MeiLang admin manifest v1",
  "description": "App-scoped admin resource index (admin/admin.toml). api_version mei-admin-resource-v1. See docs/mei-lang-v2/05-host/0545.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "resources"],
  "properties": {
    "api_version": {
      "type": "string",
      "const": "mei-admin-resource-v1"
    },
    "apiVersion": {
      "type": "string",
      "const": "mei-admin-resource-v1",
      "description": "Alias of api_version."
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "admin-resource-v1.json"
      }
    }
  }
}
